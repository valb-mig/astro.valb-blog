---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada">
  <div class="mx-auto flex max-w-2xl flex-col items-center gap-4 px-6 py-32 text-center">
    <p class="text-sm font-mono text-muted-foreground">404</p>
    <h1 class="text-2xl font-semibold">Essa página não existe</h1>
    <p class="text-sm text-muted-foreground">
      O link pode estar quebrado ou a página foi movida.
    </p>
    <a href="/" class="mt-4 text-sm font-medium underline underline-offset-4">
      voltar pra home
    </a>
  </div>
</Base>
