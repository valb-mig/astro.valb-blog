---
import Base from '../../layouts/Base.astro';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { ReactionBar } from '@/components/ReactionBar';
import { DeleteButton } from '@/components/DeleteButton';
import { Pencil } from 'lucide-react';
import { app } from '@/app';
import { visitor } from '@/app/http';
import { renderMarkdown } from '../../lib/markdown';

const admin = Astro.locals.admin;
const post = await app.posts.find({ slug: Astro.params.slug! }, admin);

if (!post) return Astro.redirect('/posts');

const [html, related, tally] = await Promise.all([
  renderMarkdown(post.content),
  app.posts.related(post),
  app.reactions.tally(post.id, visitor(Astro)),
]);

const dateStr = new Date(post.date).toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const selected = post.projects.find((p) => p.slug === Astro.url.searchParams.get('project'));
const siblings = selected ? (related.byProject[selected.id] ?? []) : related.all;
---

<Base
  title={post.title}
  description={post.description}
  og={{ type: 'article' }}
  breadcrumb={[
    { label: 'Home', href: '/' },
    { label: 'Posts', href: '/posts' },
    { label: post.slug },
  ]}
>
  <div class="mx-auto max-w-4xl px-6 py-16 md:grid md:grid-cols-[1fr_220px] md:gap-10">
    <article class="max-w-2xl">

      <header class="mb-10 border-b border-border pb-8">
        {admin && (
          <div class="mb-4 flex items-center gap-2 rounded-md border border-border bg-secondary/40 px-3 py-2 text-sm">
            {post.draft && <Badge variant="outline">draft</Badge>}
            <span class="text-muted-foreground">visão admin</span>
            <div class="ml-auto flex items-center gap-1">
              <Button variant="ghost" size="sm" asChild>
                <a href={`/admin/posts/${post.id}`} class="flex items-center gap-1">
                  <Pencil size={13} />
                  editar
                </a>
              </Button>
              <DeleteButton id={post.id} title={post.title} resource="posts" redirectTo="/posts" client:load />
            </div>
          </div>
        )}
        <h1 class="mb-3 text-3xl font-semibold leading-tight">{post.title}</h1>
        <p class="mb-5 text-muted-foreground">{post.description}</p>

        <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
          <span>{dateStr}</span>
          <span>{post.readingTime} min de leitura</span>
          <div class="flex flex-wrap gap-2 md:hidden">
            {post.projects.map((p) => (
              <a href={`/projects/${p.slug}`} class="transition-colors hover:text-foreground">
                <Badge variant="outline">{p.title}</Badge>
              </a>
            ))}
          </div>
        </div>

        {post.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {post.tags.map((tag) => (
              <a href={`/posts?tag=${tag}`}><Badge variant="outline">{tag}</Badge></a>
            ))}
          </div>
        )}
      </header>

      <div class="prose prose-invert prose-sm max-w-none" set:html={html} />

      <div class="mt-10 border-t border-border pt-6">
        <ReactionBar client:load post={post.id} tally={tally} />
      </div>

      <div class="mt-16 border-t border-border pt-8">
        <a href="/posts" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
          ← back to posts
        </a>
      </div>
    </article>

    {post.projects.length > 0 && (
      <aside class="hidden md:block">
        <div class="sticky top-24 flex flex-col gap-8">
          <div>
            <p class="mb-3 text-sm font-medium text-muted-foreground">projetos vinculados</p>
            <div class="flex flex-col gap-1.5">
              {post.projects.map((p) => (
                <a href={`/projects/${p.slug}`} class="transition-colors hover:text-foreground">
                  <Badge variant="outline">{p.title}</Badge>
                </a>
              ))}
            </div>
          </div>

          {related.all.length > 0 && (
            <div>
              <p class="mb-3 text-sm font-medium text-muted-foreground">posts dos projetos vinculados</p>
              <div class="mb-3 flex flex-wrap gap-1.5">
                <a href={`/posts/${post.slug}`}>
                  <Badge variant={!selected ? 'default' : 'outline'}>todos</Badge>
                </a>
                {post.projects.map((p) => (
                  <a href={`/posts/${post.slug}?project=${p.slug}`}>
                    <Badge variant={selected?.slug === p.slug ? 'default' : 'outline'}>{p.title}</Badge>
                  </a>
                ))}
              </div>
              {siblings.length > 0 ? (
                <ul class="flex flex-col gap-1.5">
                  {siblings.map((s) => (
                    <li>
                      <a
                        href={`/posts/${s.slug}`}
                        class="line-clamp-2 text-xs text-muted-foreground transition-colors hover:text-foreground"
                      >
                        {s.title}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-xs text-muted-foreground">nenhum post encontrado.</p>
              )}
            </div>
          )}
        </div>
      </aside>
    )}
  </div>
</Base>
