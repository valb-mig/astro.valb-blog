---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { Badge } from '@/components/ui/badge';
import { db } from '../../lib/db';
import type { Post } from '../../lib/db';

const [{ data: allPosts }, { data: postProjectRows }] = await Promise.all([
  db
    .from('posts')
    .select('id,slug,title,description,date,tags,reading_time')
    .eq('draft', false)
    .order('date', { ascending: false }),
  db.from('post_projects').select('post_id, projects(slug, title)'),
]);

const posts = (allPosts ?? []) as Pick<Post, 'id'|'slug'|'title'|'description'|'date'|'tags'|'reading_time'>[];

type PostProjectRow = { post_id: string; projects: { slug: string; title: string } | null };
const projectsByPostId: Record<string, { slug: string; title: string }[]> = {};
for (const row of (postProjectRows ?? []) as unknown as PostProjectRow[]) {
  if (!row.projects) continue;
  (projectsByPostId[row.post_id] ??= []).push(row.projects);
}

const allTags = [...new Set(posts.flatMap((p) => p.tags ?? []))].sort();

const activeTag = Astro.url.searchParams.get('tag');
const filtered = activeTag
  ? posts.filter((p) => (p.tags ?? []).includes(activeTag))
  : posts;
---

<Base title="Posts — valb" breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Posts' }]}>
  <div class="mx-auto grid max-w-5xl grid-cols-1 gap-10 px-6 py-16 md:grid-cols-[180px_1fr]">

    <!-- Sidebar: tags -->
    <aside class="hidden md:block">
      <div class="sticky top-24 flex flex-col gap-1">
        <a href="/posts">
          <Badge variant={!activeTag ? 'default' : 'outline'} className="mb-1">all</Badge>
        </a>
        {allTags.map((tag) => (
          <a href={`/posts?tag=${tag}`}>
            <Badge variant={activeTag === tag ? 'default' : 'outline'} className="mb-1">{tag}</Badge>
          </a>
        ))}
      </div>
    </aside>

    <!-- Main content -->
    <main>
      <div class="mb-8">
        <h1 class="text-2xl font-semibold">Posts</h1>
        <p class="mt-1 text-sm text-muted-foreground">
          {filtered.length} post{filtered.length !== 1 ? 's' : ''}
          {activeTag && ` · filtrando "${activeTag}"`}
        </p>
      </div>

      <!-- Mobile tag row -->
      <div class="mb-6 flex flex-wrap gap-2 md:hidden">
        <a href="/posts"><Badge variant={!activeTag ? 'default' : 'outline'}>all</Badge></a>
        {allTags.map((tag) => (
          <a href={`/posts?tag=${tag}`}><Badge variant={activeTag === tag ? 'default' : 'outline'}>{tag}</Badge></a>
        ))}
      </div>

      {filtered.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {filtered.map((post, i) => (
            <PostCard
              id={post.id}
              slug={post.slug}
              title={post.title}
              description={post.description}
              date={post.date}
              tags={post.tags}
              projects={projectsByPostId[post.id] ?? []}
              reading_time={post.reading_time}
              delay={i * 40}
            />
          ))}
        </div>
      ) : (
        <p class="mt-8 text-sm text-muted-foreground">
          nenhum post encontrado{activeTag ? ` para "${activeTag}"` : ''}.
        </p>
      )}
    </main>
  </div>
</Base>
