---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Plus } from 'lucide-react';
import { app } from '@/app';

const admin = Astro.locals.admin;
const posts = await app.posts.list({ drafts: admin });

const tags = [...new Set(posts.flatMap((p) => p.tags))].sort();

const tag = Astro.url.searchParams.get('tag');
const filtered = tag ? posts.filter((p) => p.tags.includes(tag)) : posts;
---

<Base title="Posts — valb" breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Posts' }]}>
  <div class="mx-auto grid max-w-5xl grid-cols-1 gap-10 px-6 py-16 md:grid-cols-[180px_1fr]">

    <aside class="hidden md:block">
      <div class="sticky top-24 flex flex-col gap-1">
        <a href="/posts">
          <Badge variant={!tag ? 'default' : 'outline'} className="mb-1">all</Badge>
        </a>
        {tags.map((t) => (
          <a href={`/posts?tag=${t}`}>
            <Badge variant={tag === t ? 'default' : 'outline'} className="mb-1">{t}</Badge>
          </a>
        ))}
      </div>
    </aside>

    <main>
      <div class="mb-8 flex items-start justify-between gap-4">
        <div>
          <h1 class="text-2xl font-semibold">Posts</h1>
          <p class="mt-1 text-sm text-muted-foreground">
            {filtered.length} post{filtered.length !== 1 ? 's' : ''}
            {tag && ` · filtrando "${tag}"`}
          </p>
        </div>
        {admin && (
          <Button asChild size="sm" className="shrink-0">
            <a href="/admin/posts/new" class="flex items-center gap-1">
              <Plus size={14} />
              novo post
            </a>
          </Button>
        )}
      </div>

      <div class="mb-6 flex flex-wrap gap-2 md:hidden">
        <a href="/posts"><Badge variant={!tag ? 'default' : 'outline'}>all</Badge></a>
        {tags.map((t) => (
          <a href={`/posts?tag=${t}`}><Badge variant={tag === t ? 'default' : 'outline'}>{t}</Badge></a>
        ))}
      </div>

      {filtered.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {filtered.map((post, i) => (
            <PostCard post={post} admin={admin} delay={i * 40} />
          ))}
        </div>
      ) : (
        <p class="mt-8 text-sm text-muted-foreground">
          nenhum post encontrado{tag ? ` para "${tag}"` : ''}.
        </p>
      )}
    </main>
  </div>
</Base>
