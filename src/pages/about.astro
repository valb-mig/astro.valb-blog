---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { StackConfigDialog } from '@/components/StackConfigDialog';
import StatusCard from '../components/StatusCard.astro';
import { db } from '../lib/db';
import { iconName, faviconUrl } from '../lib/icons';
import type { StackSection, StackItem, Project } from '../lib/db';

const isAdmin = Astro.locals.isAdmin;

let statusQuery = db
  .from('projects')
  .select(
    'id,slug,title,languages,draft,repo,ci_status,latest_release,latest_release_at,uptime_url,last_status_code,last_uptime_check_at,deploy_status,deploy_status_at',
  )
  .order('title', { ascending: true });
if (!isAdmin) statusQuery = statusQuery.eq('draft', false);

const [{ data: sections }, { data: statusData }] = await Promise.all([
  db
    .from('stack_sections')
    .select('*, stack_items(*)')
    .order('order_index', { ascending: true })
    .order('order_index', { ascending: true, referencedTable: 'stack_items' }),
  statusQuery,
]);

const stackSections = (sections ?? []) as (StackSection & { stack_items: StackItem[] })[];
type StatusProject = Pick<
  Project,
  | 'id'
  | 'slug'
  | 'title'
  | 'languages'
  | 'draft'
  | 'repo'
  | 'ci_status'
  | 'latest_release'
  | 'latest_release_at'
  | 'uptime_url'
  | 'last_status_code'
  | 'last_uptime_check_at'
  | 'deploy_status'
  | 'deploy_status_at'
>;
const allStatusProjects = (statusData ?? []) as StatusProject[];
const statusProjects = allStatusProjects.filter(
  (p) => p.ci_status != null || p.latest_release != null || p.uptime_url != null || p.deploy_status != null,
);
const hasWebLink = (p: StatusProject) => (p.deploy_status as { url?: string } | null)?.url != null || p.uptime_url != null;
const webStatusProjects = statusProjects.filter(hasWebLink);
const CI_ORDER: Record<string, number> = { success: 0, in_progress: 1, queued: 1 };
const ciRank = (p: StatusProject) => CI_ORDER[p.ci_status ?? ''] ?? (p.ci_status ? 2 : 3);
const ciStatusProjects = statusProjects.filter((p) => !hasWebLink(p)).sort((a, b) => ciRank(a) - ciRank(b));

// Última atividade por repo (sem coluna dedicada em `projects` — reaproveita
// source_events, mesma fonte que já alimenta /atividade).
const statusRepos = [...new Set(statusProjects.filter((p) => p.repo).map((p) => p.repo as string))];
const lastCommitByRepo: Record<string, string> = {};
if (statusRepos.length) {
  const results = await Promise.all(
    statusRepos.map((repo) =>
      db.from('source_events').select('occurred_at').eq('repo', repo).order('occurred_at', { ascending: false }).limit(1).maybeSingle(),
    ),
  );
  statusRepos.forEach((repo, i) => {
    const occurredAt = results[i].data?.occurred_at;
    if (occurredAt) lastCommitByRepo[repo] = occurredAt;
  });
}
---

<Base title="About — valb" breadcrumb={[{ label: 'Home', href: '/' }, { label: 'About' }]}>
  <div class="mx-auto max-w-4xl px-6 py-20">
    <h1 class="mb-10 text-2xl font-semibold">Sobre mim</h1>

    <div class="grid gap-16 md:grid-cols-[1.3fr_1fr]">
      <div class="fade-in prose prose-invert prose-sm max-w-none">
        <p>
          Olá! Eu sou o <strong>Ivalber Souza</strong> (também conhecido como valb) dev backend
          movido a curiosidade e café. Gosto de entender como as coisas funcionam por dentro,
          então arquitetura de sistema é praticamente um hobby pra mim (sim, eu sei).
        </p>
        <p>
          Esse blog é meio que um caderno público: registro o que ando construindo, os problemas
          que resolvo (ou pelo menos tento) e as ideias que ficam martelando na cabeça. Sem
          calendário fixo, sem categoria rígida publico quando tenho algo que valha a pena contar.
        </p>

        <h2>O que você encontra aqui</h2>
        <p>
          Posts técnicos, devlogs de projeto e, de vez em quando, um desabafo sobre alguma decisão
          de arquitetura que me deu trabalho. Boa parte do conteúdo nasce direto da minha atividade
          no GitHub o blog se alimenta sozinho do que eu ando fazendo.
        </p>

        <h2>Contato</h2>
        <p>
          Me acha no <a href="https://github.com/valb-mig" target="_blank" rel="noopener">GitHub</a> ou
          manda um email: <a href="mailto:valb.mig@gmail.com">valb.mig@gmail.com</a> — eu respondo
          (às vezes rápido, às vezes não).
        </p>
      </div>

      {(stackSections.length > 0 || isAdmin) && (
        <div class="fade-in flex flex-col gap-8">
          <div class="flex items-center justify-between gap-4">
            <h2 class="text-lg font-semibold">Ferramentas</h2>
            {isAdmin && <StackConfigDialog client:load />}
          </div>
          {stackSections.map((section) => (
            <div>
              <h3 class="mb-3 text-sm font-medium text-muted-foreground">{section.title}</h3>
              <div class="flex flex-wrap gap-2">
                {(section.stack_items ?? [])
                  .sort((a, b) => a.order_index - b.order_index)
                  .map((item) => {
                    const icon = item.icon ? (
                      <Icon
                        name={iconName(item.icon)}
                        width={16}
                        height={16}
                        class="shrink-0"
                        style={item.icon_color ? `color:${item.icon_color}` : undefined}
                      />
                    ) : item.url ? (
                      <img
                        src={faviconUrl(item.url)}
                        alt=""
                        width={16}
                        height={16}
                        loading="lazy"
                        decoding="async"
                        fetchpriority="low"
                        class="size-4 shrink-0"
                      />
                    ) : null;
                    return item.url ? (
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener"
                        class="flex items-center gap-1.5 rounded-full border border-border px-3 py-1.5 text-sm transition-colors hover:border-foreground/40 hover:text-foreground"
                      >
                        {icon}
                        {item.label}
                      </a>
                    ) : (
                      <span class="flex items-center gap-1.5 rounded-full border border-border px-3 py-1.5 text-sm text-muted-foreground">
                        {icon}
                        {item.label}
                      </span>
                    );
                  })}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    {(statusProjects.length > 0 || isAdmin) && (
      <div id="status" class="fade-in mt-16 scroll-mt-20">
        <h2 class="mb-1 text-2xl font-semibold">Status dos sistemas</h2>
        <p class="mb-6 text-sm text-muted-foreground">estado atual dos projetos — CI, versão, atividade, uptime.</p>

        {statusProjects.length > 0 ? (
          <div class="flex flex-col gap-10">
            {webStatusProjects.length > 0 && (
              <div>
                <h3 class="mb-3 text-xs font-medium tracking-wide text-muted-foreground uppercase">Com site</h3>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                  {webStatusProjects.map((p, i) => (
                    <StatusCard
                      title={p.title}
                      slug={p.slug}
                      repo={p.repo}
                      languages={p.languages}
                      draft={p.draft}
                      ciStatus={p.ci_status}
                      latestRelease={p.latest_release}
                      latestReleaseAt={p.latest_release_at}
                      uptimeUrl={p.uptime_url}
                      lastStatusCode={p.last_status_code}
                      lastUptimeCheckAt={p.last_uptime_check_at}
                      deployStatus={p.deploy_status}
                      deployStatusAt={p.deploy_status_at}
                      lastCommitAt={p.repo ? lastCommitByRepo[p.repo] : null}
                      isAdmin={isAdmin}
                      delay={i * 60}
                    />
                  ))}
                </div>
              </div>
            )}

            {ciStatusProjects.length > 0 && (
              <div>
                <h3 class="mb-3 text-xs font-medium tracking-wide text-muted-foreground uppercase">Backend / CI</h3>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                  {ciStatusProjects.map((p, i) => (
                    <StatusCard
                      title={p.title}
                      slug={p.slug}
                      repo={p.repo}
                      languages={p.languages}
                      draft={p.draft}
                      ciStatus={p.ci_status}
                      latestRelease={p.latest_release}
                      latestReleaseAt={p.latest_release_at}
                      uptimeUrl={p.uptime_url}
                      lastStatusCode={p.last_status_code}
                      lastUptimeCheckAt={p.last_uptime_check_at}
                      deployStatus={p.deploy_status}
                      deployStatusAt={p.deploy_status_at}
                      lastCommitAt={p.repo ? lastCommitByRepo[p.repo] : null}
                      isAdmin={isAdmin}
                      delay={i * 60}
                    />
                  ))}
                </div>
              </div>
            )}
          </div>
        ) : (
          <p class="text-sm text-muted-foreground">nenhum projeto com status configurado.</p>
        )}
      </div>
    )}
  </div>
</Base>

<script>
  document.querySelectorAll('.fade-in').forEach((el) => {
    setTimeout(() => el.classList.add('visible'), 100);
  });
</script>
