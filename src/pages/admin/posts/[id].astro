---
import Admin from '../../../layouts/Admin.astro';
import MarkdownEditor from '../../../components/MarkdownEditor.astro';
import { MultiSelect } from '@/components/MultiSelect';
import { Label } from '@/components/ui/label';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';
import { DeleteButton } from '@/components/DeleteButton';
import { db } from '../../../lib/db';
import type { Post } from '../../../lib/db';

const { id } = Astro.params;
const { data: post, error } = await db.from('posts').select('*').eq('id', id!).single();

if (error || !post) return Astro.redirect('/admin/posts');

const p = post as Post;
const dateStr = new Date(p.date).toISOString().split('T')[0];

const { data: allPosts } = await db.from('posts').select('tags');
const existingTags = Array.from(new Set((allPosts ?? []).flatMap((post) => post.tags ?? [])))
  .sort()
  .map((t) => ({ value: t, label: t }));

const { data: allProjects } = await db.from('projects').select('id,title').order('title');
const projectOptions = (allProjects ?? []).map((pr) => ({ value: pr.id, label: pr.title }));

const { data: links } = await db.from('post_projects').select('project_id').eq('post_id', p.id);
const currentProjectIds = (links ?? []).map((l) => l.project_id);
---

<Admin title={`Editar: ${p.title}`}>
  <div class="mb-8 flex flex-wrap items-start justify-between gap-4">
    <h1 class="text-xl font-semibold">Editar post</h1>
  </div>

  <form id="post-form" class="flex flex-col gap-6">
    <input type="hidden" id="post-id" value={p.id} />

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-title">título *</Label>
        <Input id="f-title" type="text" required value={p.title} />
      </div>
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-slug">slug *</Label>
        <Input id="f-slug" type="text" required value={p.slug} />
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <Label htmlFor="f-description">descrição *</Label>
      <Input id="f-description" type="text" required value={p.description} />
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-date">data *</Label>
        <Input id="f-date" type="date" required value={dateStr} />
      </div>
      <div class="flex flex-col gap-1.5">
        <Label>tags</Label>
        <input type="hidden" id="f-tags-value" value={JSON.stringify(p.tags ?? [])} />
        <MultiSelect
          client:load
          hiddenInputId="f-tags-value"
          initialValue={p.tags ?? []}
          options={existingTags}
          creatable
          placeholder="buscar ou criar tag..."
          triggerLabel="tag"
        />
      </div>
      <div class="flex flex-col gap-1.5">
        <Label>projetos</Label>
        <input type="hidden" id="f-projects-value" value={JSON.stringify(currentProjectIds)} />
        <MultiSelect
          client:load
          hiddenInputId="f-projects-value"
          initialValue={currentProjectIds}
          options={projectOptions}
          placeholder="buscar projeto..."
          triggerLabel="projeto"
        />
      </div>
    </div>

    <div class="flex gap-6">
      <label class="flex items-center gap-2 text-sm text-muted-foreground">
        <input id="f-draft" type="checkbox" checked={p.draft} class="accent-primary" />
        draft
      </label>
      <label class="flex items-center gap-2 text-sm text-muted-foreground">
        <input id="f-newsletter" type="checkbox" checked={p.newsletter} class="accent-primary" />
        newsletter
      </label>
    </div>

    <div class="flex flex-col gap-1.5">
      <Label>conteúdo (markdown)</Label>
      <MarkdownEditor name="content" initialValue={p.content} />
    </div>

    <div class="flex flex-wrap items-center gap-4 pt-2">
      <Button type="submit" id="save-btn">salvar alterações</Button>
      <a href={`/blog/${p.slug}`} target="_blank" class="text-sm text-muted-foreground hover:text-foreground">ver post ↗</a>
      <a href="/admin/posts" class="text-sm text-muted-foreground hover:text-foreground">voltar</a>
      <div class="ml-auto">
        <DeleteButton id={p.id} title={p.title} resource="posts" redirectTo="/admin/posts" client:load />
      </div>
      <p id="save-error" class="hidden w-full text-sm text-destructive"></p>
    </div>
  </form>
</Admin>

<script>
  const postId = (document.getElementById('post-id') as HTMLInputElement).value;
  const form = document.getElementById('post-form')!;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  const saveError = document.getElementById('save-error')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveError.classList.add('hidden');
    saveBtn.disabled = true;
    saveBtn.textContent = 'salvando...';

    const tags = JSON.parse((document.getElementById('f-tags-value') as HTMLInputElement).value || '[]');
    const projectIds = JSON.parse((document.getElementById('f-projects-value') as HTMLInputElement).value || '[]');

    const payload = {
      title: (document.getElementById('f-title') as HTMLInputElement).value,
      slug: (document.getElementById('f-slug') as HTMLInputElement).value,
      description: (document.getElementById('f-description') as HTMLInputElement).value,
      date: new Date((document.getElementById('f-date') as HTMLInputElement).value).toISOString(),
      tags,
      draft: (document.getElementById('f-draft') as HTMLInputElement).checked,
      newsletter: (document.getElementById('f-newsletter') as HTMLInputElement).checked,
      projectIds,
      content: (document.getElementById('md-content-value') as HTMLTextAreaElement).value,
    };

    const res = await fetch(`/api/posts/${postId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (res.ok) {
      saveBtn.textContent = 'salvo!';
      setTimeout(() => {
        saveBtn.disabled = false;
        saveBtn.textContent = 'salvar alterações';
      }, 1500);
    } else {
      const { error } = await res.json();
      saveError.textContent = error ?? 'Erro ao salvar';
      saveError.classList.remove('hidden');
      saveBtn.disabled = false;
      saveBtn.textContent = 'salvar alterações';
    }
  });
</script>
