---
import Base from '../../../layouts/Base.astro';
import MarkdownEditor from '../../../components/MarkdownEditor.astro';
import { MultiSelect } from '@/components/MultiSelect';
import { SwitchField } from '@/components/SwitchField';
import { Label } from '@/components/ui/label';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';
import { DeleteButton } from '@/components/DeleteButton';
import { app } from '@/app';

const post = await app.posts.find({ id: Astro.params.id! }, true);

if (!post) return Astro.redirect('/posts');

const [posts, projects] = await Promise.all([app.posts.list({ drafts: true }), app.projects.list({ drafts: true })]);

const dateStr = new Date(post.date).toISOString().split('T')[0];
const tags = [...new Set(posts.flatMap((p) => p.tags))].sort().map((t) => ({ value: t, label: t }));
const options = projects.map((p) => ({ value: p.id, label: p.title })).sort((a, b) => a.label.localeCompare(b.label));
const linked = post.projects.map((p) => p.id);
const repos = [...new Set(projects.flatMap((p) => (p.repo && linked.includes(p.id) ? [p.repo] : [])))];
---

<Base
  title={`Editar: ${post.title}`}
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Posts', href: '/posts' }, { label: post.slug, href: `/posts/${post.slug}` }, { label: 'editar' }]}
>
  <div class="mx-auto max-w-3xl px-6 py-16">
  <div class="mb-8 flex flex-wrap items-start justify-between gap-4">
    <h1 class="text-xl font-semibold">Editar post</h1>
  </div>

  <form id="post-form" class="flex flex-col gap-6">
    <input type="hidden" id="post-id" value={post.id} />

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-title">título *</Label>
        <Input id="f-title" type="text" required value={post.title} />
      </div>
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-slug">slug *</Label>
        <Input id="f-slug" type="text" required value={post.slug} />
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <Label htmlFor="f-description">descrição *</Label>
      <Input id="f-description" type="text" required value={post.description} />
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-date">data *</Label>
        <Input id="f-date" type="date" required value={dateStr} />
      </div>
      <div class="flex flex-col gap-1.5">
        <Label>tags</Label>
        <input type="hidden" id="f-tags-value" value={JSON.stringify(post.tags)} />
        <MultiSelect
          client:load
          hiddenInputId="f-tags-value"
          initialValue={post.tags}
          options={tags}
          creatable
          placeholder="buscar ou criar tag..."
          triggerLabel="tag"
        />
      </div>
      <div class="flex flex-col gap-1.5">
        <Label>projetos</Label>
        <input type="hidden" id="f-projects-value" value={JSON.stringify(linked)} />
        <MultiSelect
          client:load
          hiddenInputId="f-projects-value"
          initialValue={linked}
          options={options}
          placeholder="buscar projeto..."
          triggerLabel="projeto"
        />
      </div>
    </div>

    <div class="flex gap-6">
      <div class="flex items-center gap-2.5">
        <input type="hidden" id="f-draft" value={String(post.draft)} />
        <SwitchField client:load hiddenInputId="f-draft" initialChecked={post.draft} />
        <Label htmlFor="f-draft">draft</Label>
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <Label>conteúdo (markdown)</Label>
      <MarkdownEditor name="content" initialValue={post.content} repos={repos} />
    </div>

    <div class="flex flex-wrap items-center gap-4 pt-2">
      <Button type="submit" id="save-btn">salvar alterações</Button>
      <a href={`/posts/${post.slug}`} class="text-sm text-muted-foreground hover:text-foreground">voltar ao post</a>
      <div class="ml-auto">
        <DeleteButton id={post.id} title={post.title} resource="posts" redirectTo="/posts" client:load />
      </div>
    </div>
  </form>
  </div>
</Base>

<script>
  import { toast } from 'sonner';

  const id = (document.getElementById('post-id') as HTMLInputElement).value;
  const form = document.getElementById('post-form')!;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveBtn.textContent = 'salvando...';

    const tags = JSON.parse((document.getElementById('f-tags-value') as HTMLInputElement).value || '[]');
    const projects = JSON.parse((document.getElementById('f-projects-value') as HTMLInputElement).value || '[]');

    const payload = {
      title: (document.getElementById('f-title') as HTMLInputElement).value,
      slug: (document.getElementById('f-slug') as HTMLInputElement).value,
      description: (document.getElementById('f-description') as HTMLInputElement).value,
      date: new Date((document.getElementById('f-date') as HTMLInputElement).value).toISOString(),
      tags,
      draft: (document.getElementById('f-draft') as HTMLInputElement).value === 'true',
      projects,
      content: (document.getElementById('md-content-value') as HTMLTextAreaElement).value,
    };

    const res = await fetch(`/api/posts/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (res.ok) {
      toast.success('Alterações salvas.');
      saveBtn.disabled = false;
      saveBtn.textContent = 'salvar alterações';
    } else {
      const { error } = await res.json();
      toast.error(error ?? 'Erro ao salvar');
      saveBtn.disabled = false;
      saveBtn.textContent = 'salvar alterações';
    }
  });
</script>
