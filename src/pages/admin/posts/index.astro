---
import Admin from '../../../layouts/Admin.astro';
import { db } from '../../../lib/db';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';
import { DeleteButton } from '@/components/DeleteButton';
import { Plus } from 'lucide-react';

const { data: posts } = await db
  .from('posts')
  .select('id,slug,title,date,draft,tags,reading_time')
  .order('date', { ascending: false });
---

<Admin title="Posts">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="text-xl font-semibold">Posts</h1>
    <Button asChild>
      <a href="/admin/posts/new" class="flex items-center gap-1">
        <Plus size={14} />
        novo post
      </a>
    </Button>
  </div>

  {!posts?.length ? (
    <p class="text-sm text-muted-foreground">
      nenhum post ainda. <a href="/admin/posts/new" class="text-foreground underline">criar primeiro →</a>
    </p>
  ) : (
    <div class="rounded-lg border border-border">
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>título</TableHead>
            <TableHead>data</TableHead>
            <TableHead>status</TableHead>
            <TableHead className="text-right">ações</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {(posts ?? []).map((post) => (
            <TableRow data-id={post.id}>
              <TableCell>
                <a href={`/admin/posts/${post.id}`} class="font-medium hover:underline">{post.title}</a>
                <p class="text-xs text-muted-foreground">{post.slug}</p>
              </TableCell>
              <TableCell className="text-muted-foreground">
                {new Date(post.date).toLocaleDateString('pt-BR')}
              </TableCell>
              <TableCell>
                <Badge variant={post.draft ? 'outline' : 'default'}>{post.draft ? 'draft' : 'live'}</Badge>
              </TableCell>
              <TableCell className="text-right">
                <div class="flex items-center justify-end gap-1">
                  <Button variant="ghost" size="sm" asChild>
                    <a href={`/blog/${post.slug}`} target="_blank">ver ↗</a>
                  </Button>
                  <Button variant="ghost" size="sm" asChild>
                    <a href={`/admin/posts/${post.id}`}>editar</a>
                  </Button>
                  <DeleteButton id={post.id} title={post.title} resource="posts" client:load />
                </div>
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </div>
  )}

  <script>
    document.addEventListener('row-deleted', (e) => {
      const { id } = (e as CustomEvent).detail;
      document.querySelector(`tr[data-id="${id}"]`)?.remove();
    });
  </script>
</Admin>
