---
import Admin from '../../../layouts/Admin.astro';
import MarkdownEditor from '../../../components/MarkdownEditor.astro';
import { MultiSelect } from '@/components/MultiSelect';
import { Label } from '@/components/ui/label';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';
import { db } from '../../../lib/db';

const { data: allPosts } = await db.from('posts').select('tags');
const existingTags = Array.from(new Set((allPosts ?? []).flatMap((p) => p.tags ?? [])))
  .sort()
  .map((t) => ({ value: t, label: t }));

const { data: allProjects } = await db.from('projects').select('id,title').order('title');
const projectOptions = (allProjects ?? []).map((p) => ({ value: p.id, label: p.title }));
---

<Admin title="Novo Post">
  <h1 class="mb-8 text-xl font-semibold">Novo post</h1>

  <form id="post-form" class="flex flex-col gap-6">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-title">título *</Label>
        <Input id="f-title" type="text" required placeholder="Título do post" />
      </div>
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-slug">slug *</Label>
        <Input id="f-slug" type="text" required placeholder="titulo-do-post" />
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <Label htmlFor="f-description">descrição *</Label>
      <Input id="f-description" type="text" required placeholder="Resumo curto para cards e SEO" />
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-date">data *</Label>
        <Input id="f-date" type="date" required />
      </div>
      <div class="flex flex-col gap-1.5">
        <Label>tags</Label>
        <input type="hidden" id="f-tags-value" value="[]" />
        <MultiSelect
          client:load
          hiddenInputId="f-tags-value"
          initialValue={[]}
          options={existingTags}
          creatable
          placeholder="buscar ou criar tag..."
          triggerLabel="tag"
        />
      </div>
      <div class="flex flex-col gap-1.5">
        <Label>projetos</Label>
        <input type="hidden" id="f-projects-value" value="[]" />
        <MultiSelect
          client:load
          hiddenInputId="f-projects-value"
          initialValue={[]}
          options={projectOptions}
          placeholder="buscar projeto..."
          triggerLabel="projeto"
        />
      </div>
    </div>

    <div class="flex gap-6">
      <label class="flex items-center gap-2 text-sm text-muted-foreground">
        <input id="f-draft" type="checkbox" checked class="accent-primary" />
        draft (não publicado)
      </label>
    </div>

    <div class="flex flex-col gap-1.5">
      <Label>conteúdo (markdown)</Label>
      <MarkdownEditor name="content" />
    </div>

    <div class="flex items-center gap-4 pt-2">
      <Button type="submit" id="save-btn">salvar post</Button>
      <a href="/admin/posts" class="text-sm text-muted-foreground hover:text-foreground">cancelar</a>
    </div>
  </form>
</Admin>

<script>
  // Auto-fill today's date
  const dateInput = document.getElementById('f-date') as HTMLInputElement;
  dateInput.value = new Date().toISOString().split('T')[0];

  // Auto-generate slug from title
  const titleInput = document.getElementById('f-title') as HTMLInputElement;
  const slugInput = document.getElementById('f-slug') as HTMLInputElement;
  let slugTouched = false;

  slugInput.addEventListener('input', () => { slugTouched = true; });
  titleInput.addEventListener('input', () => {
    if (!slugTouched) {
      slugInput.value = titleInput.value
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/[^\w\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .trim();
    }
  });

  // Form submit
  import { toast } from 'sonner';
  import { flashToast } from '../../../lib/toast';

  const form = document.getElementById('post-form')!;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveBtn.textContent = 'salvando...';

    const tags = JSON.parse((document.getElementById('f-tags-value') as HTMLInputElement).value || '[]');
    const projectIds = JSON.parse((document.getElementById('f-projects-value') as HTMLInputElement).value || '[]');

    const payload = {
      title: (document.getElementById('f-title') as HTMLInputElement).value,
      slug: (document.getElementById('f-slug') as HTMLInputElement).value,
      description: (document.getElementById('f-description') as HTMLInputElement).value,
      date: new Date((document.getElementById('f-date') as HTMLInputElement).value).toISOString(),
      tags,
      draft: (document.getElementById('f-draft') as HTMLInputElement).checked,
      projectIds,
      content: (document.getElementById('md-content-value') as HTMLTextAreaElement).value,
    };

    const res = await fetch('/api/posts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (res.ok) {
      flashToast('success', 'Post salvo.');
      window.location.href = '/admin/posts';
    } else {
      const { error } = await res.json();
      toast.error(error ?? 'Erro ao salvar');
      saveBtn.disabled = false;
      saveBtn.textContent = 'salvar post';
    }
  });
</script>
