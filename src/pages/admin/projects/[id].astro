---
import Base from '../../../layouts/Base.astro';
import MarkdownEditor from '../../../components/MarkdownEditor.astro';
import { Label } from '@/components/ui/label';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';
import { DeleteButton } from '@/components/DeleteButton';
import { SelectField } from '@/components/SelectField';
import { SwitchField } from '@/components/SwitchField';
import { db } from '../../../lib/db';
import type { Project } from '../../../lib/db';

const { id } = Astro.params;
const { data: project, error } = await db.from('projects').select('*').eq('id', id!).single();

if (error || !project) return Astro.redirect('/projects');

const p = project as Project;
const dateStr = new Date(p.date).toISOString().split('T')[0];
const tagsStr = (p.tags ?? []).join(', ');

const statusOptions = [
  { value: 'active', label: 'active' },
  { value: 'completed', label: 'completed' },
  { value: 'archived', label: 'archived' },
];
---

<Base
  title={`Editar: ${p.title}`}
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Projects', href: '/projects' }, { label: p.slug, href: `/projects/${p.slug}` }, { label: 'editar' }]}
>
  <div class="mx-auto max-w-3xl px-6 py-16">
  <h1 class="mb-8 text-xl font-semibold">Editar projeto</h1>

  <form id="proj-form" class="flex flex-col gap-6">
    <input type="hidden" id="proj-id" value={p.id} />

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-title">título *</Label>
        <Input id="f-title" type="text" required value={p.title} />
      </div>
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-slug">slug *</Label>
        <Input id="f-slug" type="text" required value={p.slug} />
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <Label htmlFor="f-description">descrição *</Label>
      <Input id="f-description" type="text" required value={p.description} />
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-date">data *</Label>
        <Input id="f-date" type="date" required value={dateStr} />
      </div>
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-status">status</Label>
        <input type="hidden" id="f-status" value={p.status} />
        <SelectField client:load hiddenInputId="f-status" initialValue={p.status} options={statusOptions} className="w-full" />
      </div>
      <div class="flex flex-col gap-1.5 sm:col-span-2">
        <Label htmlFor="f-repo">repo (owner/repositorio)</Label>
        <Input id="f-repo" type="text" value={p.repo ?? ''} placeholder="usuario/repositorio" />
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <Label htmlFor="f-uptime-url">uptime url (health-check, opcional)</Label>
      <Input id="f-uptime-url" type="url" value={p.uptime_url ?? ''} placeholder="https://meuservico.com/health" />
    </div>

    <div class="flex flex-col gap-1.5">
      <Label htmlFor="f-status-token">token de status (POST /api/projects/{p.id}/status)</Label>
      <div class="flex gap-2">
        <Input id="f-status-token" type="text" readOnly value={p.status_token ?? ''} placeholder="ainda não gerado" className="font-mono text-xs" />
        <Button type="button" id="gen-token-btn" variant="outline">gerar novo</Button>
      </div>
    </div>

    <div class="flex flex-wrap gap-6">
      <div class="flex items-center gap-2.5">
        <input type="hidden" id="f-ingest-private" value={String(p.ingest_private ?? false)} />
        <SwitchField client:load hiddenInputId="f-ingest-private" initialChecked={p.ingest_private ?? false} />
        <Label htmlFor="f-ingest-private">incluir no ingest (repo privado)</Label>
      </div>
      <div class="flex items-center gap-2.5">
        <input type="hidden" id="f-mention-allowed" value={String(p.mention_allowed ?? true)} />
        <SwitchField client:load hiddenInputId="f-mention-allowed" initialChecked={p.mention_allowed ?? true} />
        <Label htmlFor="f-mention-allowed">mencionar no post de atividade</Label>
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <Label htmlFor="f-tags">tags (vírgula)</Label>
      <Input id="f-tags" type="text" value={tagsStr} />
    </div>

    <div class="flex items-center gap-2.5">
      <input type="hidden" id="f-draft" value={String(p.draft)} />
      <SwitchField client:load hiddenInputId="f-draft" initialChecked={p.draft} />
      <Label htmlFor="f-draft">draft</Label>
    </div>

    <div class="flex flex-col gap-1.5">
      <Label>descrição longa (markdown)</Label>
      <MarkdownEditor name="content" initialValue={p.content} />
    </div>

    <div class="flex flex-wrap items-center gap-4 pt-2">
      <Button type="submit" id="save-btn">salvar alterações</Button>
      <a href={`/projects/${p.slug}`} class="text-sm text-muted-foreground hover:text-foreground">voltar ao projeto</a>
      <div class="ml-auto">
        <DeleteButton id={p.id} title={p.title} resource="projects" redirectTo="/projects" client:load />
      </div>
    </div>
  </form>
  </div>
</Base>

<script>
  import { toast } from 'sonner';

  const projId = (document.getElementById('proj-id') as HTMLInputElement).value;
  const form = document.getElementById('proj-form')!;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveBtn.textContent = 'salvando...';

    const tagsRaw = (document.getElementById('f-tags') as HTMLInputElement).value;
    const repoVal = (document.getElementById('f-repo') as HTMLInputElement).value.trim();
    const uptimeUrlVal = (document.getElementById('f-uptime-url') as HTMLInputElement).value.trim();

    const payload = {
      title: (document.getElementById('f-title') as HTMLInputElement).value,
      slug: (document.getElementById('f-slug') as HTMLInputElement).value,
      description: (document.getElementById('f-description') as HTMLInputElement).value,
      date: new Date((document.getElementById('f-date') as HTMLInputElement).value).toISOString(),
      status: (document.getElementById('f-status') as HTMLInputElement).value,
      tags: tagsRaw.split(',').map((t: string) => t.trim()).filter(Boolean),
      repo: repoVal || null,
      uptime_url: uptimeUrlVal || null,
      ingest_private: (document.getElementById('f-ingest-private') as HTMLInputElement).value === 'true',
      mention_allowed: (document.getElementById('f-mention-allowed') as HTMLInputElement).value === 'true',
      draft: (document.getElementById('f-draft') as HTMLInputElement).value === 'true',
      content: (document.getElementById('md-content-value') as HTMLTextAreaElement).value,
    };

    const res = await fetch(`/api/projects/${projId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (res.ok) {
      toast.success('Alterações salvas.');
      saveBtn.disabled = false;
      saveBtn.textContent = 'salvar alterações';
    } else {
      const { error } = await res.json();
      toast.error(error ?? 'Erro ao salvar');
      saveBtn.disabled = false;
      saveBtn.textContent = 'salvar alterações';
    }
  });

  document.getElementById('gen-token-btn')?.addEventListener('click', async () => {
    const bytes = crypto.getRandomValues(new Uint8Array(32));
    const token = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');

    const res = await fetch(`/api/projects/${projId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status_token: token }),
    });

    if (res.ok) {
      (document.getElementById('f-status-token') as HTMLInputElement).value = token;
      toast.success('Novo token gerado — atualize o secret no repo que reporta status.');
    } else {
      toast.error('Erro ao gerar token');
    }
  });
</script>
