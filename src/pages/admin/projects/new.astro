---
import Base from '../../../layouts/Base.astro';
import MarkdownEditor from '../../../components/MarkdownEditor.astro';
import { Label } from '@/components/ui/label';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';
import { SelectField } from '@/components/SelectField';
import { SwitchField } from '@/components/SwitchField';

const statusOptions = [
  { value: 'active', label: 'active' },
  { value: 'completed', label: 'completed' },
  { value: 'archived', label: 'archived' },
];
---

<Base title="Novo Projeto" breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Projects', href: '/projects' }, { label: 'novo' }]}>
  <div class="mx-auto max-w-3xl px-6 py-16">
  <h1 class="mb-8 text-xl font-semibold">Novo projeto</h1>

  <form id="proj-form" class="flex flex-col gap-6">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-title">título *</Label>
        <Input id="f-title" type="text" required placeholder="Nome do projeto" />
      </div>
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-slug">slug *</Label>
        <Input id="f-slug" type="text" required placeholder="nome-do-projeto" />
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <Label htmlFor="f-description">descrição *</Label>
      <Input id="f-description" type="text" required placeholder="Resumo curto" />
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-date">data *</Label>
        <Input id="f-date" type="date" required />
      </div>
      <div class="flex flex-col gap-1.5">
        <Label htmlFor="f-status">status</Label>
        <input type="hidden" id="f-status" value="active" />
        <SelectField client:load hiddenInputId="f-status" initialValue="active" options={statusOptions} className="w-full" />
      </div>
      <div class="flex flex-col gap-1.5 sm:col-span-2">
        <Label htmlFor="f-repo">repo (owner/repositorio)</Label>
        <Input id="f-repo" type="text" placeholder="usuario/repositorio" />
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <Label htmlFor="f-uptime-url">uptime url (health-check, opcional)</Label>
      <Input id="f-uptime-url" type="url" placeholder="https://meuservico.com/health" />
    </div>

    <div class="flex flex-wrap gap-6">
      <div class="flex items-center gap-2.5">
        <input type="hidden" id="f-ingest-private" value="false" />
        <SwitchField client:load hiddenInputId="f-ingest-private" initialChecked={false} />
        <Label htmlFor="f-ingest-private">incluir no ingest (repo privado)</Label>
      </div>
      <div class="flex items-center gap-2.5">
        <input type="hidden" id="f-mention-allowed" value="true" />
        <SwitchField client:load hiddenInputId="f-mention-allowed" initialChecked={true} />
        <Label htmlFor="f-mention-allowed">mencionar no post de atividade</Label>
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <Label htmlFor="f-tags">tags (vírgula)</Label>
      <Input id="f-tags" type="text" placeholder="astro, typescript" />
    </div>

    <div class="flex items-center gap-2.5">
      <input type="hidden" id="f-draft" value="true" />
      <SwitchField client:load hiddenInputId="f-draft" initialChecked={true} />
      <Label htmlFor="f-draft">draft</Label>
    </div>

    <div class="flex flex-col gap-1.5">
      <Label>descrição longa (markdown)</Label>
      <MarkdownEditor name="content" />
    </div>

    <div class="flex items-center gap-4 pt-2">
      <Button type="submit" id="save-btn">salvar projeto</Button>
      <a href="/projects" class="text-sm text-muted-foreground hover:text-foreground">cancelar</a>
    </div>
  </form>
  </div>
</Base>

<script>
  const dateInput = document.getElementById('f-date') as HTMLInputElement;
  dateInput.value = new Date().toISOString().split('T')[0];

  const titleInput = document.getElementById('f-title') as HTMLInputElement;
  const slugInput = document.getElementById('f-slug') as HTMLInputElement;
  let slugTouched = false;
  slugInput.addEventListener('input', () => { slugTouched = true; });
  titleInput.addEventListener('input', () => {
    if (!slugTouched) {
      slugInput.value = titleInput.value
        .toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
        .replace(/[^\w\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').trim();
    }
  });

  import { toast } from 'sonner';
  import { flashToast } from '../../../lib/toast';

  const form = document.getElementById('proj-form')!;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveBtn.textContent = 'salvando...';

    const tagsRaw = (document.getElementById('f-tags') as HTMLInputElement).value;
    const repoVal = (document.getElementById('f-repo') as HTMLInputElement).value.trim();
    const uptimeUrlVal = (document.getElementById('f-uptime-url') as HTMLInputElement).value.trim();

    const payload = {
      title: (document.getElementById('f-title') as HTMLInputElement).value,
      slug: (document.getElementById('f-slug') as HTMLInputElement).value,
      description: (document.getElementById('f-description') as HTMLInputElement).value,
      date: new Date((document.getElementById('f-date') as HTMLInputElement).value).toISOString(),
      status: (document.getElementById('f-status') as HTMLInputElement).value,
      tags: tagsRaw.split(',').map((t: string) => t.trim()).filter(Boolean),
      repo: repoVal || null,
      uptime_url: uptimeUrlVal || null,
      ingest_private: (document.getElementById('f-ingest-private') as HTMLInputElement).value === 'true',
      mention_allowed: (document.getElementById('f-mention-allowed') as HTMLInputElement).value === 'true',
      draft: (document.getElementById('f-draft') as HTMLInputElement).value === 'true',
      content: (document.getElementById('md-content-value') as HTMLTextAreaElement).value,
    };

    const res = await fetch('/api/projects', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (res.ok) {
      const created = await res.json();
      flashToast('success', 'Projeto salvo.');
      window.location.href = `/projects/${created.slug}`;
    } else {
      const { error } = await res.json();
      toast.error(error ?? 'Erro ao salvar');
      saveBtn.disabled = false;
      saveBtn.textContent = 'salvar projeto';
    }
  });
</script>
