---
import Admin from '../../../layouts/Admin.astro';
import MarkdownEditor from '../../../components/MarkdownEditor.astro';
---

<Admin title="Novo Projeto">
  <div>
    <div style="margin-bottom: 2rem;">
      <p style="font-size: 0.75rem; color: var(--subtle); margin-bottom: 0.25rem;">❯ mkdir projects/novo</p>
      <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--text);"># novo projeto</h1>
    </div>

    <form id="proj-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div>
          <label class="field-label">título *</label>
          <input id="f-title" type="text" required placeholder="Nome do projeto" class="field-input" />
        </div>
        <div>
          <label class="field-label">slug *</label>
          <input id="f-slug" type="text" required placeholder="nome-do-projeto" class="field-input" />
        </div>
      </div>

      <div>
        <label class="field-label">descrição *</label>
        <input id="f-description" type="text" required placeholder="Resumo curto" class="field-input" />
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 1rem;">
        <div>
          <label class="field-label">data *</label>
          <input id="f-date" type="date" required class="field-input" />
        </div>
        <div>
          <label class="field-label">status</label>
          <select id="f-status" class="field-input">
            <option value="active">active</option>
            <option value="completed">completed</option>
            <option value="archived">archived</option>
          </select>
        </div>
        <div>
          <label class="field-label">repo (URL)</label>
          <input id="f-repo" type="url" placeholder="https://github.com/..." class="field-input" />
        </div>
        <div>
          <label class="field-label">site (URL)</label>
          <input id="f-url" type="url" placeholder="https://..." class="field-input" />
        </div>
      </div>

      <div>
        <label class="field-label">tags (vírgula)</label>
        <input id="f-tags" type="text" placeholder="astro, typescript" class="field-input" />
      </div>

      <div>
        <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; color: var(--muted); cursor: pointer;">
          <input id="f-draft" type="checkbox" checked style="accent-color: var(--accent);" />
          draft
        </label>
      </div>

      <div>
        <label class="field-label" style="margin-bottom: 0.5rem;">descrição longa (markdown)</label>
        <MarkdownEditor name="content" />
      </div>

      <div style="display: flex; gap: 1rem; align-items: center; padding-top: 0.5rem;">
        <button type="submit" id="save-btn" style="
          font-family: inherit; font-size: 0.875rem; font-weight: 600;
          background: var(--accent); color: var(--bg);
          border: none; padding: 0.65rem 1.5rem; cursor: pointer;
        ">
          ❯ salvar projeto
        </button>
        <a href="/admin/projects" style="font-size: 0.8125rem; color: var(--subtle);">cancelar</a>
        <p id="save-error" style="font-size: 0.8125rem; color: #f87171; display: none;"></p>
      </div>
    </form>
  </div>
</Admin>

<style>
.field-label { font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.4rem; }
.field-input {
  width: 100%; background: var(--surface); border: 1px solid var(--border);
  color: var(--text); font-family: inherit; font-size: 0.875rem;
  padding: 0.55rem 0.75rem; outline: none; transition: border-color 0.2s;
}
.field-input:focus { border-color: var(--accent); }
@media (max-width: 600px) {
  div[style*="grid-template-columns"] { grid-template-columns: 1fr !important; }
}
</style>

<script>
  const dateInput = document.getElementById('f-date') as HTMLInputElement;
  dateInput.value = new Date().toISOString().split('T')[0];

  const titleInput = document.getElementById('f-title') as HTMLInputElement;
  const slugInput = document.getElementById('f-slug') as HTMLInputElement;
  let slugTouched = false;
  slugInput.addEventListener('input', () => { slugTouched = true; });
  titleInput.addEventListener('input', () => {
    if (!slugTouched) {
      slugInput.value = titleInput.value
        .toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
        .replace(/[^\w\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').trim();
    }
  });

  const form = document.getElementById('proj-form')!;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  const saveError = document.getElementById('save-error')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveError.style.display = 'none';
    saveBtn.disabled = true;
    saveBtn.textContent = '❯ salvando...';

    const tagsRaw = (document.getElementById('f-tags') as HTMLInputElement).value;
    const repoVal = (document.getElementById('f-repo') as HTMLInputElement).value.trim();
    const urlVal = (document.getElementById('f-url') as HTMLInputElement).value.trim();

    const payload = {
      title: (document.getElementById('f-title') as HTMLInputElement).value,
      slug: (document.getElementById('f-slug') as HTMLInputElement).value,
      description: (document.getElementById('f-description') as HTMLInputElement).value,
      date: new Date((document.getElementById('f-date') as HTMLInputElement).value).toISOString(),
      status: (document.getElementById('f-status') as HTMLSelectElement).value,
      tags: tagsRaw.split(',').map((t: string) => t.trim()).filter(Boolean),
      repo: repoVal || null,
      url: urlVal || null,
      draft: (document.getElementById('f-draft') as HTMLInputElement).checked,
      content: (document.getElementById('md-content-value') as HTMLTextAreaElement).value,
    };

    const res = await fetch('/api/projects', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (res.ok) {
      window.location.href = '/admin/projects';
    } else {
      const { error } = await res.json();
      saveError.textContent = error ?? 'Erro ao salvar';
      saveError.style.display = 'block';
      saveBtn.disabled = false;
      saveBtn.textContent = '❯ salvar projeto';
    }
  });
</script>
