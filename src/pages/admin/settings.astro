---
import Admin from '../../layouts/Admin.astro';
import { Label } from '@/components/ui/label';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { SelectField } from '@/components/SelectField';
import { SwitchField } from '@/components/SwitchField';
import { db } from '../../lib/db';

const providerOptions = [
  { value: 'groq', label: 'groq' },
  { value: 'gemini', label: 'gemini' },
];

const { data: settingsRows } = await db
  .from('settings')
  .select('key,value')
  .in('key', ['llm_provider', 'llm_fallback_enabled', 'maintenance_mode']);
const settings = Object.fromEntries((settingsRows ?? []).map((s) => [s.key, s.value]));
const currentProvider = settings.llm_provider ?? 'groq';
const fallbackEnabled = (settings.llm_fallback_enabled ?? 'true') === 'true';
const maintenanceEnabled = (settings.maintenance_mode ?? 'false') === 'true';

const hasGroqKey = !!import.meta.env.GROQ_API_KEY;
const hasGeminiKey = !!import.meta.env.GEMINI_API_KEY;
---

<Admin title="Settings">
  <h1 class="mb-8 text-xl font-semibold">Settings</h1>

  <div class="mb-8 flex max-w-sm flex-col gap-2 rounded-lg border border-border p-4">
    <p class="text-sm font-medium">API keys do provider de LLM</p>
    <div class="flex items-center gap-2 text-sm">
      <Badge variant={hasGroqKey ? 'default' : 'outline'}>{hasGroqKey ? 'ok' : 'faltando'}</Badge>
      <span class="text-muted-foreground">GROQ_API_KEY</span>
    </div>
    <div class="flex items-center gap-2 text-sm">
      <Badge variant={hasGeminiKey ? 'default' : 'outline'}>{hasGeminiKey ? 'ok' : 'faltando'}</Badge>
      <span class="text-muted-foreground">GEMINI_API_KEY</span>
    </div>
  </div>

  <form id="settings-form" class="flex max-w-sm flex-col gap-6">
    <div class="flex flex-col gap-1.5">
      <Label htmlFor="f-llm-provider">provider de normalização (ingest)</Label>
      <input type="hidden" id="f-llm-provider" value={currentProvider} />
      <SelectField client:load hiddenInputId="f-llm-provider" initialValue={currentProvider} options={providerOptions} className="w-full" />
      <p class="text-xs text-muted-foreground">
        modelo usado pra normalizar a atividade de GitHub em texto de post no pipeline de ingest.
      </p>
    </div>

    <div class="flex items-start gap-2.5">
      <input type="hidden" id="f-llm-fallback" value={String(fallbackEnabled)} />
      <SwitchField client:load hiddenInputId="f-llm-fallback" initialChecked={fallbackEnabled} />
      <div class="flex flex-col gap-1">
        <Label htmlFor="f-llm-fallback">fallback automático Gemini → Groq</Label>
        <p class="text-xs text-muted-foreground">
          se o provider ativo for gemini e ele falhar (erro de API, rate limit), tenta de novo via groq. só funciona
          com GROQ_API_KEY configurada.
        </p>
      </div>
    </div>

    <div class="flex items-start gap-2.5">
      <input type="hidden" id="f-maintenance-mode" value={String(maintenanceEnabled)} />
      <SwitchField client:load hiddenInputId="f-maintenance-mode" initialChecked={maintenanceEnabled} />
      <div class="flex flex-col gap-1">
        <Label htmlFor="f-maintenance-mode">modo manutenção</Label>
        <p class="text-xs text-muted-foreground">
          bloqueia as páginas públicas do site (mostra uma tela de manutenção) pra quem não estiver
          logado como admin. API e RSS continuam funcionando.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <Button type="submit" id="save-btn">salvar</Button>
    </div>
  </form>
</Admin>

<script>
  import { toast } from 'sonner';

  const form = document.getElementById('settings-form')!;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;

  async function saveSetting(key: string, value: string): Promise<void> {
    const res = await fetch('/api/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key, value }),
    });
    if (!res.ok) {
      const { error } = await res.json().catch(() => ({ error: null }));
      throw new Error(error ?? 'Erro ao salvar');
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveBtn.textContent = 'salvando...';

    const provider = (document.getElementById('f-llm-provider') as HTMLInputElement).value;
    const fallbackEnabled = (document.getElementById('f-llm-fallback') as HTMLInputElement).value === 'true';
    const maintenanceEnabled = (document.getElementById('f-maintenance-mode') as HTMLInputElement).value === 'true';

    try {
      await Promise.all([
        saveSetting('llm_provider', provider),
        saveSetting('llm_fallback_enabled', String(fallbackEnabled)),
        saveSetting('maintenance_mode', String(maintenanceEnabled)),
      ]);
      toast.success('Salvo.');
    } catch (err) {
      toast.error(err instanceof Error ? err.message : 'Erro ao salvar');
    }

    saveBtn.disabled = false;
    saveBtn.textContent = 'salvar';
  });
</script>
