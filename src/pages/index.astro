---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WakatimeWidget from '../components/WakatimeWidget.astro';
import OrgBadge from '../components/OrgBadge.astro';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { RefreshCw } from 'lucide-react';
import { app } from '@/app';
import { ago } from '../lib/time';
import { render } from '../lib/markdown';
import type { Status } from '@/core/run/run';

const admin = Astro.locals.admin;

const [home, stats] = await Promise.all([app.home.get(admin), admin ? app.stats.get() : null]);
const { today, work, posts, projects } = home;
const lead = today ? await render(today.lead) : '';

const fresh = (iso: string) => Date.now() - Date.parse(iso) < 24 * 60 * 60 * 1000;

const weekday = (date: string) =>
  new Date(`${date}T12:00:00Z`).toLocaleDateString('pt-BR', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    timeZone: 'UTC',
  });

const variant: { [s in Status]: 'default' | 'secondary' | 'outline' } = {
  success: 'default',
  error: 'outline',
  running: 'secondary',
};

const messages = [
  'Codando muito...',
  'Quebrando build de propósito pra aprender algo novo.',
  'Refatorando o que não devia.',
  'Debugando às 2h da manhã.',
  'Commitando "fix" pela quinta vez hoje.',
  '99 problemas e um cache invalidado é um deles.',
  'Testando em produção (não conta se ninguém ver).',
  'Lendo docs que eu mesmo devia ter escrito.',
  'Convertido mais um café em código.',
  'Procurando ponto e vírgula perdido.',
];
const status = messages[Math.floor(Math.random() * messages.length)];
---

<Base title="valb">
  <div class="mx-auto max-w-5xl px-6">

    <div class="fade-in flex justify-center pt-16">
      <span class="text-6xl font-semibold tracking-tight sm:text-7xl">
        <span class="text-muted-foreground">~/</span>blog
      </span>
    </div>

    <section class="fade-in flex flex-col items-start justify-between gap-8 py-20 sm:flex-row sm:items-center">
      <div class="flex flex-col gap-2">
        <h1 class="text-2xl font-semibold">valb-mig</h1>
        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-green-500 opacity-75"></span>
            <span class="relative inline-flex size-2 rounded-full bg-green-500"></span>
          </span>
          {status}
        </div>
      </div>
      <div class="w-full sm:w-96">
        <WakatimeWidget />
      </div>
    </section>

    {(today || work.length > 0) && (
      <section class="fade-in pb-20">
        <div class="mb-6 flex items-baseline justify-between">
          <h2 class="text-lg font-semibold">Trabalhando em</h2>
          <a href="/atividade" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
            atividade →
          </a>
        </div>
        <div class={`grid grid-cols-1 gap-4 ${today && work.length ? 'lg:grid-cols-2' : ''}`}>
          {today && (
            <a href={`/posts/${today.slug}`} class="group">
              <Card className="h-full transition-colors group-hover:ring-foreground/20">
                <CardContent className="flex h-full flex-col gap-3">
                  <span class="text-xs text-muted-foreground first-letter:uppercase">
                    {weekday(today.date)} · {ago(`${today.date}T23:59:59Z`)}
                  </span>
                  <div
                    class="line-clamp-6 text-sm leading-relaxed [&_code]:rounded [&_code]:bg-muted [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-xs"
                    set:html={lead}
                  />
                  <span class="mt-auto text-xs text-muted-foreground transition-colors group-hover:text-foreground">
                    ler o dia →
                  </span>
                </CardContent>
              </Card>
            </a>
          )}
          {work.length > 0 && (
            <Card className="gap-0 py-0">
              <p class="border-b border-border px-4 py-2.5 text-xs text-muted-foreground">últimos 7 dias</p>
              <ul class="divide-y divide-border">
                {work.slice(0, 6).map((w) => {
                  const org = app.projects.org(w.repo);
                  const name = w.project?.title ?? w.repo.split('/')[1];
                  return (
                    <li class="flex items-center gap-3 px-4 py-2.5">
                      <span
                        class={`size-2 shrink-0 rounded-full ${fresh(w.last) ? 'bg-emerald-500' : 'bg-muted-foreground/40'}`}
                        title={fresh(w.last) ? 'commit nas últimas 24h' : undefined}
                      />
                      <span class="flex min-w-0 flex-1 items-center gap-2">
                        {org && <OrgBadge org={org} />}
                        {w.project ? (
                          <a href={`/projects/${w.project.slug}`} class="truncate text-sm font-medium hover:text-foreground/80">
                            {name}
                          </a>
                        ) : (
                          <span class="truncate font-mono text-sm">{name}</span>
                        )}
                      </span>
                      <span class="shrink-0 text-xs text-muted-foreground tabular-nums">
                        {w.commits} {w.commits === 1 ? 'commit' : 'commits'} · {ago(w.last)}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </Card>
          )}
        </div>
      </section>
    )}

    <section class="pb-20">
      <div class="mb-6 flex items-baseline justify-between">
        <h2 class="text-lg font-semibold">Posts recentes</h2>
        <a href="/posts" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
          ver todos →
        </a>
      </div>
      {posts.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, i) => (
            <PostCard post={post} delay={i * 80} />
          ))}
        </div>
      ) : (
        <p class="text-sm text-muted-foreground">nenhum post ainda.</p>
      )}
    </section>

    {projects.length > 0 && (
      <section class="pb-24">
        <div class="mb-6 flex items-baseline justify-between">
          <h2 class="text-lg font-semibold">Projetos</h2>
          <a href="/projects" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
            ver todos →
          </a>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project, i) => (
            <ProjectCard project={project} pinned={project.pinned} last={project.last} admin={admin} delay={i * 80} />
          ))}
        </div>
      </section>
    )}

    {stats && (
      <section class="fade-in pb-20">
        <h2 class="mb-6 text-lg font-semibold">Painel admin</h2>
        <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
          <Card>
            <CardHeader>
              <CardTitle className="text-sm font-medium text-muted-foreground">Posts</CardTitle>
            </CardHeader>
            <CardContent>
              <p class="text-2xl font-semibold">{stats.posts}</p>
            </CardContent>
          </Card>
          <Card>
            <CardHeader>
              <CardTitle className="text-sm font-medium text-muted-foreground">Projects</CardTitle>
            </CardHeader>
            <CardContent>
              <p class="text-2xl font-semibold">{stats.projects}</p>
            </CardContent>
          </Card>
          <Card>
            <CardHeader>
              <CardTitle className="text-sm font-medium text-muted-foreground">Reactions</CardTitle>
            </CardHeader>
            <CardContent>
              <p class="text-2xl font-semibold">{stats.reactions}</p>
            </CardContent>
          </Card>
        </div>

        <section>
          <h2 class="mb-2 text-sm font-medium capitalize text-muted-foreground flex justify-between">
            Ingests recentes
            <Button id="run-ingest-btn" size="sm" className="flex w-fit items-center gap-1.5">
              <RefreshCw size={14} />
              rodar ingest agora
            </Button>
          </h2>
          <div class="flex flex-col">
            {stats.runs.length ? (
              <ul class="flex flex-col divide-y divide-border">
                {stats.runs.map((run) => (
                  <li class="flex flex-col gap-1 py-3 first:pt-0 last:pb-0">
                    <div class="flex items-center gap-2 text-sm">
                      <Badge variant={variant[run.status] ?? 'outline'}>{run.status}</Badge>
                      <span class="text-muted-foreground">
                        {run.date} · {run.trigger}
                      </span>
                    </div>
                    <p class="text-xs text-muted-foreground">
                      {run.created} evento(s) criado(s)
                      {run.fallback ? ' · fallback Gemini→Groq usado' : ''}
                    </p>
                    {run.error && <p class="text-xs text-destructive">{run.error}</p>}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm text-muted-foreground">nenhuma run registrada ainda.</p>
            )}            
          </div>
        </section>
      </section>
    )}
  </div>
</Base>

{stats && (
  <script>
    import { toast } from 'sonner';

    const btn = document.getElementById('run-ingest-btn') as HTMLButtonElement;
    btn?.addEventListener('click', async () => {
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = 'disparando...';

      const res = await fetch('/api/admin/ingest-trigger', { method: 'POST' });

      if (res.ok) {
        toast.success('Workflow disparado. Acompanhe no GitHub Actions.');
      } else {
        const { error } = await res.json().catch(() => ({ error: null }));
        toast.error(error ?? 'Falha ao disparar ingest.');
      }

      btn.disabled = false;
      btn.textContent = original;
    });
  </script>
)}
