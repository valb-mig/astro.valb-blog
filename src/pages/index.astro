---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { Button } from '@/components/ui/button';
import { Cat, GitCommit, Rss } from 'lucide-react';
import { db } from '../lib/db';
import type { Post, Project } from '../lib/db';

const [postsRes, projectsRes, postProjectRes] = await Promise.all([
  db
    .from('posts')
    .select('id,slug,title,description,date,tags,reading_time')
    .eq('draft', false)
    .order('date', { ascending: false })
    .limit(3),
  db
    .from('projects')
    .select('id,slug,title,description,date,tags,status,repo')
    .eq('draft', false)
    .eq('status', 'active')
    .order('date', { ascending: false })
    .limit(3),
  db
    .from('post_projects')
    .select('post_id, project_id, projects(slug, title), posts!inner(draft)')
    .eq('posts.draft', false),
]);

const latestPosts = (postsRes.data ?? []) as Pick<Post, 'id'|'slug'|'title'|'description'|'date'|'tags'|'reading_time'>[];
const activeProjects = (projectsRes.data ?? []) as Pick<Project, 'id'|'slug'|'title'|'description'|'date'|'tags'|'status'|'repo'>[];

type PostProjectRow = { post_id: string; project_id: string; projects: { slug: string; title: string } | null };
const postProjectRows = (postProjectRes.data ?? []) as unknown as PostProjectRow[];

// Projetos linkados por post + contagem de posts por projeto, ambos derivados
// da mesma query de post_projects.
const projectsByPostId: Record<string, { slug: string; title: string }[]> = {};
const postCountMap: Record<string, number> = {};
for (const row of postProjectRows) {
  if (!row.projects) continue;
  (projectsByPostId[row.post_id] ??= []).push(row.projects);
  postCountMap[row.project_id] = (postCountMap[row.project_id] ?? 0) + 1;
}
---

<Base title="valb">
  <div class="mx-auto max-w-5xl px-6">

    <!-- Hero -->
    <section class="fade-in flex flex-col items-start gap-5 py-20">
      <div class="flex size-14 items-center justify-center rounded-full bg-muted text-lg font-medium">V</div>
      <div class="flex flex-col gap-2">
        <h1 class="text-2xl font-semibold">valb-mig</h1>
        <p class="max-w-lg text-sm leading-relaxed text-muted-foreground">
          Desenvolvedor apaixonado por ferramentas, automação e interfaces bonitas.
          Escrevo sobre código, projetos e ideias.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <Button variant="outline" size="sm" asChild>
          <a href="https://github.com/valb-mig" target="_blank" rel="noopener" class="flex items-center gap-1">
            <Cat size={14} />
            GitHub
          </a>
        </Button>
        <Button variant="outline" size="sm" asChild>
          <a href="/rss.xml" class="flex items-center gap-1">
            <Rss size={14} />
            RSS
          </a>
        </Button>
      </div>
    </section>

    <!-- Latest Posts -->
    <section class="pb-20">
      <div class="mb-6 flex items-baseline justify-between">
        <h2 class="text-lg font-semibold">Posts recentes</h2>
        <a href="/blog" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
          ver todos →
        </a>
      </div>
      {latestPosts.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {latestPosts.map((post, i) => (
            <PostCard
              id={post.id}
              slug={post.slug}
              title={post.title}
              description={post.description}
              date={post.date}
              tags={post.tags}
              projects={projectsByPostId[post.id] ?? []}
              reading_time={post.reading_time}
              delay={i * 80}
            />
          ))}
        </div>
      ) : (
        <p class="text-sm text-muted-foreground">nenhum post ainda.</p>
      )}
    </section>

    <!-- Active Projects -->
    {activeProjects.length > 0 && (
      <section class="pb-24">
        <div class="mb-6 flex items-baseline justify-between">
          <h2 class="text-lg font-semibold">Projetos ativos</h2>
          <a href="/projects" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
            ver todos →
          </a>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {activeProjects.map((project, i) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              date={new Date(project.date)}
              slug={project.slug}
              tags={project.tags}
              status={project.status}
              repo={project.repo ?? undefined}
              postCount={postCountMap[project.id] ?? 0}
              delay={i * 80}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
