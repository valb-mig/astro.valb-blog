---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WakatimeWidget from '../components/WakatimeWidget.astro';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { RefreshCw } from 'lucide-react';
import { db } from '../lib/db';
import type { Post, Project } from '../lib/db';

const isAdmin = Astro.locals.isAdmin;

const [postsRes, projectsRes, postProjectRes, adminStatsRes] = await Promise.all([
  db
    .from('posts')
    .select('id,slug,title,description,date,tags,reading_time')
    .eq('draft', false)
    .order('date', { ascending: false })
    .limit(3),
  db
    .from('projects')
    .select('id,slug,title,description,date,tags,status,repo')
    .eq('draft', false)
    .eq('status', 'active')
    .order('date', { ascending: false })
    .limit(3),
  db
    .from('post_projects')
    .select('post_id, project_id, projects(slug, title), posts!inner(draft)')
    .eq('posts.draft', false),
  isAdmin
    ? Promise.all([
        db.from('posts').select('*', { count: 'exact', head: true }),
        db.from('projects').select('*', { count: 'exact', head: true }),
        db.from('post_reactions').select('*', { count: 'exact', head: true }),
        db.from('ingest_runs').select('*').order('started_at', { ascending: false }).limit(10),
      ])
    : null,
]);

let adminStats: { postsCount: number; projectsCount: number; reactionsCount: number; runs: any[] } | null = null;
if (adminStatsRes) {
  const [{ count: postsCount }, { count: projectsCount }, { count: reactionsCount }, { data: recentRuns }] = adminStatsRes;
  adminStats = {
    postsCount: postsCount ?? 0,
    projectsCount: projectsCount ?? 0,
    reactionsCount: reactionsCount ?? 0,
    runs: recentRuns ?? [],
  };
}

const statusVariant: Record<string, 'default' | 'secondary' | 'outline'> = {
  success: 'default',
  error: 'outline',
  running: 'secondary',
};

const latestPosts = (postsRes.data ?? []) as Pick<Post, 'id'|'slug'|'title'|'description'|'date'|'tags'|'reading_time'>[];
const activeProjects = (projectsRes.data ?? []) as Pick<Project, 'id'|'slug'|'title'|'description'|'date'|'tags'|'status'|'repo'>[];

type PostProjectRow = { post_id: string; project_id: string; projects: { slug: string; title: string } | null };
const postProjectRows = (postProjectRes.data ?? []) as unknown as PostProjectRow[];

const statusMessages = [
  'Codando muito...',
  'Quebrando build de propósito pra aprender algo novo.',
  'Refatorando o que não devia.',
  'Debugando às 2h da manhã.',
  'Commitando "fix" pela quinta vez hoje.',
  '99 problemas e um cache invalidado é um deles.',
  'Testando em produção (não conta se ninguém ver).',
  'Lendo docs que eu mesmo devia ter escrito.',
  'Convertido mais um café em código.',
  'Procurando ponto e vírgula perdido.',
];
const status = statusMessages[Math.floor(Math.random() * statusMessages.length)];

// Projetos linkados por post + contagem de posts por projeto, ambos derivados
// da mesma query de post_projects.
const projectsByPostId: Record<string, { slug: string; title: string }[]> = {};
const postCountMap: Record<string, number> = {};
for (const row of postProjectRows) {
  if (!row.projects) continue;
  (projectsByPostId[row.post_id] ??= []).push(row.projects);
  postCountMap[row.project_id] = (postCountMap[row.project_id] ?? 0) + 1;
}
---

<Base title="valb">
  <div class="mx-auto max-w-5xl px-6">

    <!-- Logo -->
    <div class="fade-in flex justify-center pt-16">
      <span class="text-6xl font-semibold tracking-tight sm:text-7xl">
        <span class="text-muted-foreground">~/</span>blog
      </span>
    </div>

    <!-- Hero -->
    <section class="fade-in flex flex-col items-start justify-between gap-8 py-20 sm:flex-row sm:items-center">
      <div class="flex flex-col gap-2">
        <h1 class="text-2xl font-semibold">valb-mig</h1>
        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-green-500 opacity-75"></span>
            <span class="relative inline-flex size-2 rounded-full bg-green-500"></span>
          </span>
          {status}
        </div>
      </div>
      <div class="w-full sm:w-96">
        <WakatimeWidget />
      </div>
    </section>

    <!-- Admin dashboard -->
    {adminStats && (
      <section class="fade-in pb-20">
        <h2 class="mb-6 text-lg font-semibold">Painel admin</h2>
        <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
          <Card>
            <CardHeader>
              <CardTitle className="text-sm font-medium text-muted-foreground">Posts</CardTitle>
            </CardHeader>
            <CardContent>
              <p class="text-2xl font-semibold">{adminStats.postsCount}</p>
            </CardContent>
          </Card>
          <Card>
            <CardHeader>
              <CardTitle className="text-sm font-medium text-muted-foreground">Projects</CardTitle>
            </CardHeader>
            <CardContent>
              <p class="text-2xl font-semibold">{adminStats.projectsCount}</p>
            </CardContent>
          </Card>
          <Card>
            <CardHeader>
              <CardTitle className="text-sm font-medium text-muted-foreground">Reactions</CardTitle>
            </CardHeader>
            <CardContent>
              <p class="text-2xl font-semibold">{adminStats.reactionsCount}</p>
            </CardContent>
          </Card>
        </div>

        <Card className="max-w-lg">
          <CardHeader>
            <CardTitle className="text-sm font-medium">Ingests recentes</CardTitle>
          </CardHeader>
          <CardContent className="flex flex-col gap-3">
            {adminStats.runs.length ? (
              <ul class="flex flex-col divide-y divide-border">
                {adminStats.runs.map((run) => (
                  <li class="flex flex-col gap-1 py-3 first:pt-0 last:pb-0">
                    <div class="flex items-center gap-2 text-sm">
                      <Badge variant={statusVariant[run.status] ?? 'outline'}>{run.status}</Badge>
                      <span class="text-muted-foreground">
                        {run.target_date} · {run.trigger}
                      </span>
                    </div>
                    <p class="text-xs text-muted-foreground">
                      {run.events_created} evento(s) criado(s)
                      {run.llm_fallback_used ? ' · fallback Gemini→Groq usado' : ''}
                    </p>
                    {run.error_message && <p class="text-xs text-destructive">{run.error_message}</p>}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm text-muted-foreground">nenhuma run registrada ainda.</p>
            )}
            <Button id="run-ingest-btn" size="sm" className="flex w-fit items-center gap-1.5">
              <RefreshCw size={14} />
              rodar ingest agora
            </Button>
          </CardContent>
        </Card>
      </section>
    )}

    <!-- Latest Posts -->
    <section class="pb-20">
      <div class="mb-6 flex items-baseline justify-between">
        <h2 class="text-lg font-semibold">Posts recentes</h2>
        <a href="/posts" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
          ver todos →
        </a>
      </div>
      {latestPosts.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {latestPosts.map((post, i) => (
            <PostCard
              id={post.id}
              slug={post.slug}
              title={post.title}
              description={post.description}
              date={post.date}
              tags={post.tags}
              projects={projectsByPostId[post.id] ?? []}
              reading_time={post.reading_time}
              delay={i * 80}
            />
          ))}
        </div>
      ) : (
        <p class="text-sm text-muted-foreground">nenhum post ainda.</p>
      )}
    </section>

    <!-- Active Projects -->
    {activeProjects.length > 0 && (
      <section class="pb-24">
        <div class="mb-6 flex items-baseline justify-between">
          <h2 class="text-lg font-semibold">Projetos ativos</h2>
          <a href="/projects" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
            ver todos →
          </a>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {activeProjects.map((project, i) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              date={new Date(project.date)}
              slug={project.slug}
              tags={project.tags}
              status={project.status}
              repo={project.repo ?? undefined}
              postCount={postCountMap[project.id] ?? 0}
              delay={i * 80}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

{adminStats && (
  <script>
    import { toast } from 'sonner';

    const btn = document.getElementById('run-ingest-btn') as HTMLButtonElement;
    btn?.addEventListener('click', async () => {
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = 'disparando...';

      const res = await fetch('/api/admin/ingest-trigger', { method: 'POST' });

      if (res.ok) {
        toast.success('Workflow disparado. Acompanhe no GitHub Actions.');
      } else {
        const { error } = await res.json().catch(() => ({ error: null }));
        toast.error(error ?? 'Falha ao disparar ingest.');
      }

      btn.disabled = false;
      btn.textContent = original;
    });
  </script>
)}
