---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { Button } from '@/components/ui/button';
import { Rss } from 'lucide-react';
import { db } from '../lib/db';
import type { Post, Project } from '../lib/db';

const [postsRes, projectsRes, postProjectRes] = await Promise.all([
  db
    .from('posts')
    .select('id,slug,title,description,date,tags,project,newsletter,reading_time')
    .eq('draft', false)
    .order('date', { ascending: false })
    .limit(3),
  db
    .from('projects')
    .select('id,slug,title,description,date,tags,status,repo,url')
    .eq('draft', false)
    .eq('status', 'active')
    .order('date', { ascending: false })
    .limit(3),
  db
    .from('posts')
    .select('project')
    .eq('draft', false)
    .not('project', 'is', null),
]);

const latestPosts = (postsRes.data ?? []) as Pick<Post, 'id'|'slug'|'title'|'description'|'date'|'tags'|'project'|'newsletter'|'reading_time'>[];
const activeProjects = (projectsRes.data ?? []) as Pick<Project, 'id'|'slug'|'title'|'description'|'date'|'tags'|'status'|'repo'|'url'>[];

// Post counts per project
const postProjectData = postProjectRes.data;

const postCountMap: Record<string, number> = {};
(postProjectData ?? []).forEach((p: { project: string | null }) => {
  if (p.project) postCountMap[p.project] = (postCountMap[p.project] ?? 0) + 1;
});
---

<Base title="valb">
  <div class="mx-auto max-w-5xl px-6">

    <!-- Hero -->
    <section class="fade-in flex flex-col items-start gap-5 py-20">
      <div class="flex size-14 items-center justify-center rounded-full bg-muted text-lg font-medium">V</div>
      <div class="flex flex-col gap-2">
        <h1 class="text-2xl font-semibold">valb-mig</h1>
        <p class="max-w-lg text-sm leading-relaxed text-muted-foreground">
          Desenvolvedor apaixonado por ferramentas, automação e interfaces bonitas.
          Escrevo sobre código, projetos e ideias.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <Button variant="outline" size="sm" asChild>
          <a href="https://github.com/valb-mig" target="_blank" rel="noopener">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            GitHub
          </a>
        </Button>
        <Button variant="outline" size="sm" asChild>
          <a href="/rss.xml">
            <Rss />
            RSS
          </a>
        </Button>
      </div>
    </section>

    <!-- Latest Posts -->
    <section class="pb-20">
      <div class="mb-6 flex items-baseline justify-between">
        <h2 class="text-lg font-semibold">Posts recentes</h2>
        <a href="/blog" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
          ver todos →
        </a>
      </div>
      {latestPosts.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {latestPosts.map((post, i) => (
            <PostCard
              id={post.id}
              slug={post.slug}
              title={post.title}
              description={post.description}
              date={post.date}
              tags={post.tags}
              project={post.project}
              newsletter={post.newsletter}
              reading_time={post.reading_time}
              delay={i * 80}
            />
          ))}
        </div>
      ) : (
        <p class="text-sm text-muted-foreground">nenhum post ainda.</p>
      )}
    </section>

    <!-- Active Projects -->
    {activeProjects.length > 0 && (
      <section class="pb-24">
        <div class="mb-6 flex items-baseline justify-between">
          <h2 class="text-lg font-semibold">Projetos ativos</h2>
          <a href="/projects" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
            ver todos →
          </a>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {activeProjects.map((project, i) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              date={new Date(project.date)}
              slug={project.slug}
              tags={project.tags}
              status={project.status}
              repo={project.repo ?? undefined}
              url={project.url ?? undefined}
              postCount={postCountMap[project.slug] ?? 0}
              delay={i * 80}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
