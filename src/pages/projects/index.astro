---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectFilters from '../../components/ProjectFilters';
import { Button } from '@/components/ui/button';
import { Network, Plus } from 'lucide-react';
import { db } from '../../lib/db';
import type { Project } from '../../lib/db';

const isAdmin = Astro.locals.isAdmin;

let projectsQuery = db
  .from('projects')
  .select('id,slug,title,description,date,tags,status,repo,languages,draft')
  .order('date', { ascending: false });
if (!isAdmin) projectsQuery = projectsQuery.eq('draft', false);

const [projectsRes, postProjectRes] = await Promise.all([
  projectsQuery,
  db.from('post_projects').select('project_id, posts!inner(draft)').eq('posts.draft', false),
]);

const projects = (projectsRes.data ?? []) as Pick<Project, 'id'|'slug'|'title'|'description'|'date'|'tags'|'status'|'repo'|'languages'|'draft'>[];

const postCountMap: Record<string, number> = {};
((postProjectRes.data ?? []) as unknown as { project_id: string }[]).forEach((row) => {
  postCountMap[row.project_id] = (postCountMap[row.project_id] ?? 0) + 1;
});

const allTags = [...new Set(projects.flatMap((p) => p.tags ?? []))].sort();

const sections = [
  { label: 'Ativos', items: projects.filter((p) => p.status === 'active') },
  { label: 'Concluídos', items: projects.filter((p) => p.status === 'completed') },
  { label: 'Arquivados', items: projects.filter((p) => p.status === 'archived') },
];
---

<Base title="Projects — valb" breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Projects' }]}>
  <div class="mx-auto max-w-5xl px-6 py-16">
    <div class="mb-8 flex items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold">Projects</h1>
        <p id="results-count" class="mt-1 text-sm text-muted-foreground">
          {projects.length} projeto{projects.length !== 1 ? 's' : ''}
        </p>
      </div>
      <div class="flex items-center gap-3">
        {isAdmin && (
          <Button asChild size="sm" className="shrink-0">
            <a href="/admin/projects/new" class="flex items-center gap-1">
              <Plus size={14} />
              novo projeto
            </a>
          </Button>
        )}
        <a
          href="/projects/graph"
          title="ver grafo de projetos e posts"
          class="mt-1 text-muted-foreground transition-colors hover:text-foreground"
        >
          <Network className="size-5" />
        </a>
      </div>
    </div>

    <div class="mb-8">
      <ProjectFilters client:load tags={allTags} />
    </div>

    {sections.map((section) => section.items.length > 0 && (
      <section class="mb-12" data-section>
        <p class="mb-4 text-sm font-medium text-muted-foreground">{section.label}</p>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {section.items.map((p, i) => (
            <div data-project-card data-title={p.title.toLowerCase()} data-tags={(p.tags ?? []).join(' ')}>
              <ProjectCard
                id={p.id}
                title={p.title}
                description={p.description}
                date={new Date(p.date)}
                slug={p.slug}
                tags={p.tags}
                status={p.status}
                repo={p.repo ?? undefined}
                languages={p.languages}
                postCount={postCountMap[p.id] ?? 0}
                draft={p.draft}
                isAdmin={isAdmin}
                delay={i * 80}
              />
            </div>
          ))}
        </div>
      </section>
    ))}

    <p id="empty-state" class="text-sm text-muted-foreground" hidden>
      nenhum projeto encontrado.
    </p>
  </div>
</Base>
