---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import LanguageBadges from '../../components/LanguageBadges.astro';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { DeleteButton } from '@/components/DeleteButton';
import { Pencil } from 'lucide-react';
import { app } from '@/app';
import type { Status } from '@/core/project/project';
import { render } from '../../lib/markdown';

const admin = Astro.locals.admin;

const p = await app.projects.find({ slug: Astro.params.slug! }, admin);

if (!p) return Astro.redirect('/projects');

const [html, posts] = await Promise.all([
  render(p.content),
  app.posts.list({ drafts: false, projects: [p.id] }),
]);
const repoUrl = p.repo ? `https://github.com/${p.repo}` : null;

const variant: { [s in Status]: 'default' | 'secondary' | 'outline' } = {
  active: 'default',
  completed: 'secondary',
  archived: 'outline',
};

const dateStr = new Date(p.date).toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base
  title={`${p.title} — Projects`}
  description={p.description}
  breadcrumb={[
    { label: 'Home', href: '/' },
    { label: 'Projects', href: '/projects' },
    { label: p.slug },
  ]}
>
  <div class="mx-auto max-w-4xl px-6 py-16 md:grid md:grid-cols-[1fr_220px] md:gap-10">
    <div class="max-w-2xl">

      <header class="mb-10 border-b border-border pb-8">
        {admin && (
          <div class="mb-4 flex items-center gap-2 rounded-md border border-border bg-secondary/40 px-3 py-2 text-sm">
            {p.draft && <Badge variant="outline">draft</Badge>}
            <span class="text-muted-foreground">visão admin</span>
            <div class="ml-auto flex items-center gap-1">
              <Button variant="ghost" size="sm" asChild>
                <a href={`/admin/projects/${p.id}`} class="flex items-center gap-1">
                  <Pencil size={13} />
                  editar
                </a>
              </Button>
              <DeleteButton id={p.id} title={p.title} resource="projects" redirectTo="/projects" client:load />
            </div>
          </div>
        )}
        <h1 class="mb-3 text-3xl font-semibold">{p.title}</h1>
        <p class="mb-5 text-muted-foreground">{p.description}</p>

        <div class="flex flex-wrap items-center gap-3 text-sm">
          <Badge variant={variant[p.status]}>{p.status}</Badge>
          <span class="text-muted-foreground">{dateStr}</span>
          {repoUrl && (
            <a href={repoUrl} target="_blank" rel="noopener" class="text-muted-foreground transition-colors hover:text-foreground">
              repo ↗
            </a>
          )}
        </div>

        {p.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {p.tags.map((tag) => <Badge variant="outline">{tag}</Badge>)}
          </div>
        )}

        <div class="mt-4">
          <LanguageBadges languages={p.languages} />
        </div>
      </header>

      {p.content && (
        <div class="prose prose-invert prose-sm mb-16 max-w-none" set:html={html} />
      )}

      <section id="posts" class="md:hidden">
        <h2 class="mb-6 text-lg font-semibold">Posts sobre esse projeto</h2>
        {posts.length > 0 ? (
          <div class="grid grid-cols-1 gap-4">
            {posts.map((post, i) => (
              <PostCard post={{ ...post, projects: [] }} delay={i * 60} />
            ))}
          </div>
        ) : (
          <p class="text-sm text-muted-foreground">nenhum post encontrado.</p>
        )}
      </section>

      <div class="mt-16 border-t border-border pt-8">
        <a href="/projects" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
          ← back to projects
        </a>
      </div>
    </div>

    <aside class="hidden md:block">
      <div class="sticky top-24 flex flex-col gap-3">
        <p class="text-sm font-medium text-muted-foreground">posts sobre esse projeto</p>
        {posts.length > 0 ? (
          <ul class="flex flex-col gap-2">
            {posts.map((post) => (
              <li>
                <a
                  href={`/posts/${post.slug}`}
                  class="line-clamp-2 text-xs text-muted-foreground transition-colors hover:text-foreground"
                >
                  {post.title}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-xs text-muted-foreground">nenhum post encontrado.</p>
        )}
      </div>
    </aside>
  </div>
</Base>
