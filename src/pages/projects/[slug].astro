---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Tag from '../../components/Tag.astro';
import { db } from '../../lib/db';
import type { Project, Post } from '../../lib/db';
import { marked } from 'marked';

const { slug } = Astro.params;

const { data: project, error } = await db
  .from('projects')
  .select('*')
  .eq('slug', slug!)
  .eq('draft', false)
  .single();

if (error || !project) return Astro.redirect('/projects');

const p = project as Project;
const contentHtml = await marked.parse(p.content);

const { data: linkedPostsRaw } = await db
  .from('posts')
  .select('id,slug,title,description,date,tags,reading_time')
  .eq('draft', false)
  .eq('project', p.slug)
  .order('date', { ascending: false });

const linkedPosts = (linkedPostsRaw ?? []) as Pick<Post, 'id'|'slug'|'title'|'description'|'date'|'tags'|'reading_time'>[];

const statusColor = {
  active: 'var(--accent)',
  completed: 'var(--muted)',
  archived: 'var(--subtle)',
};

const dateStr = new Date(p.date).toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${p.title} — projects`} description={p.description}>
  <div style="max-width: 72rem; margin: 0 auto; padding: 6rem 1.5rem 8rem;">

    <p style="font-size: 0.75rem; color: var(--subtle); margin-bottom: 2rem;">
      <a href="/" style="color: var(--accent);">~</a>
      <span> / </span>
      <a href="/projects" style="color: var(--muted);">projects</a>
      <span> / </span>
      <span style="color: var(--muted);">{p.slug}</span>
    </p>

    <header style="margin-bottom: 3rem; border-bottom: 1px solid var(--border); padding-bottom: 2rem;">
      <p style="font-size: 0.75rem; color: var(--subtle); margin-bottom: 0.75rem;">
        ❯ cat projects/{p.slug}/README.md
      </p>
      <h1 style="font-size: 2rem; font-weight: 700; color: var(--text); margin-bottom: 0.75rem;">
        ⬡ {p.title}
      </h1>
      <p style="color: var(--muted); margin-bottom: 1.25rem;">{p.description}</p>

      <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; font-size: 0.75rem;">
        <span style={`color: ${statusColor[p.status]}; border: 1px solid ${statusColor[p.status]}; padding: 0.1em 0.5em; border-radius: 2px;`}>
          {p.status}
        </span>
        <span style="color: var(--subtle);">{dateStr}</span>
        {p.repo && (
          <a href={p.repo} target="_blank" rel="noopener"
            style="color: var(--muted); transition: color 0.2s;"
            onmouseover="this.style.color='var(--accent)';"
            onmouseout="this.style.color='var(--muted)';"
          >repo ↗</a>
        )}
        {p.url && (
          <a href={p.url} target="_blank" rel="noopener"
            style="color: var(--muted); transition: color 0.2s;"
            onmouseover="this.style.color='var(--accent)';"
            onmouseout="this.style.color='var(--muted)';"
          >site ↗</a>
        )}
      </div>

      {(p.tags ?? []).length > 0 && (
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem;">
          {(p.tags ?? []).map((tag: string) => <Tag tag={tag} />)}
        </div>
      )}
    </header>

    {p.content && (
      <div class="prose" style="margin-bottom: 4rem;" set:html={contentHtml} />
    )}

    {linkedPosts.length > 0 && (
      <section id="posts">
        <div style="margin-bottom: 1.5rem;">
          <p style="font-size: 0.75rem; color: var(--subtle); margin-bottom: 0.25rem;">
            ❯ ls blog/ --project={p.slug}
          </p>
          <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text);">
            # posts sobre esse projeto
          </h2>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem;">
          {linkedPosts.map((post, i) => (
            <PostCard
              id={post.id}
              slug={post.slug}
              title={post.title}
              description={post.description}
              date={post.date}
              tags={post.tags}
              reading_time={post.reading_time}
              delay={i * 60}
            />
          ))}
        </div>
      </section>
    )}

    <div style="margin-top: 4rem; border-top: 1px solid var(--border); padding-top: 2rem;">
      <a href="/projects" style="font-size: 0.875rem; color: var(--muted); transition: color 0.2s;"
        onmouseover="this.style.color='var(--accent)';"
        onmouseout="this.style.color='var(--muted)';"
      >← back to projects</a>
    </div>
  </div>
</Base>
