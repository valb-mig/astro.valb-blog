---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { Badge } from '@/components/ui/badge';
import { db } from '../../lib/db';
import type { Project, Post } from '../../lib/db';
import { marked } from 'marked';

const { slug } = Astro.params;

const { data: project, error } = await db
  .from('projects')
  .select('*')
  .eq('slug', slug!)
  .eq('draft', false)
  .single();

if (error || !project) return Astro.redirect('/projects');

const p = project as Project;
const contentHtml = await marked.parse(p.content);

const { data: linkedPostsRaw } = await db
  .from('posts')
  .select('id,slug,title,description,date,tags,reading_time')
  .eq('draft', false)
  .eq('project', p.slug)
  .order('date', { ascending: false });

const linkedPosts = (linkedPostsRaw ?? []) as Pick<Post, 'id'|'slug'|'title'|'description'|'date'|'tags'|'reading_time'>[];

const statusVariant: Record<string, 'default' | 'secondary' | 'outline'> = {
  active: 'default',
  completed: 'secondary',
  archived: 'outline',
};

const dateStr = new Date(p.date).toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${p.title} — Projects`} description={p.description}>
  <div class="mx-auto max-w-2xl px-6 py-16">

    <p class="mb-8 text-sm text-muted-foreground">
      <a href="/" class="hover:text-foreground">Home</a>
      <span> / </span>
      <a href="/projects" class="hover:text-foreground">Projects</a>
      <span> / </span>
      <span>{p.slug}</span>
    </p>

    <header class="mb-10 border-b border-border pb-8">
      <h1 class="mb-3 text-3xl font-semibold">{p.title}</h1>
      <p class="mb-5 text-muted-foreground">{p.description}</p>

      <div class="flex flex-wrap items-center gap-3 text-sm">
        <Badge variant={statusVariant[p.status]}>{p.status}</Badge>
        <span class="text-muted-foreground">{dateStr}</span>
        {p.repo && (
          <a href={p.repo} target="_blank" rel="noopener" class="text-muted-foreground transition-colors hover:text-foreground">
            repo ↗
          </a>
        )}
        {p.url && (
          <a href={p.url} target="_blank" rel="noopener" class="text-muted-foreground transition-colors hover:text-foreground">
            site ↗
          </a>
        )}
      </div>

      {(p.tags ?? []).length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {(p.tags ?? []).map((tag: string) => <Badge variant="outline">{tag}</Badge>)}
        </div>
      )}
    </header>

    {p.content && (
      <div class="prose prose-invert prose-sm mb-16 max-w-none" set:html={contentHtml} />
    )}

    {linkedPosts.length > 0 && (
      <section id="posts">
        <h2 class="mb-6 text-lg font-semibold">Posts sobre esse projeto</h2>
        <div class="grid grid-cols-1 gap-4">
          {linkedPosts.map((post, i) => (
            <PostCard
              id={post.id}
              slug={post.slug}
              title={post.title}
              description={post.description}
              date={post.date}
              tags={post.tags}
              reading_time={post.reading_time}
              delay={i * 60}
            />
          ))}
        </div>
      </section>
    )}

    <div class="mt-16 border-t border-border pt-8">
      <a href="/projects" class="text-sm text-muted-foreground transition-colors hover:text-foreground">
        ← back to projects
      </a>
    </div>
  </div>
</Base>
