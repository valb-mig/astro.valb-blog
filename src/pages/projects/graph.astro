---
import Base from '../../layouts/Base.astro';
import ProjectGraph from '../../components/ProjectGraph';
import { app } from '@/app';

const [projects, posts] = await Promise.all([
  app.projects.list({ drafts: false }),
  app.posts.list({ drafts: false }),
]);

const ids = new Set(projects.map((p) => p.id));
const edges = posts.flatMap((post) =>
  post.projects.filter((p) => ids.has(p.id)).map((p) => ({ source: p.id, target: post.id })),
);
const linked = new Set(edges.map((e) => e.target));

const nodes = [
  ...projects.map((p) => ({ id: p.id, label: p.title, type: 'project' as const, slug: p.slug, tags: p.tags })),
  ...posts
    .filter((p) => linked.has(p.id))
    .map((p) => ({ id: p.id, label: p.title, type: 'post' as const, slug: p.slug })),
];

const tags = [...new Set(projects.flatMap((p) => p.tags))].sort();
---

<Base title="Grafo — valb" breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Projects', href: '/projects' }, { label: 'Grafo' }]}>
  <div class="mx-auto max-w-5xl px-6 py-16">
    <div class="mb-8">
      <h1 class="text-2xl font-semibold">Grafo de projetos</h1>
      <p class="mt-1 text-sm text-muted-foreground">projetos e posts que citam eles, como um grafo de conexões.</p>
    </div>

    <ProjectGraph client:only="react" nodes={nodes} links={edges} tags={tags} />
  </div>
</Base>
