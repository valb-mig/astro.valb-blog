---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { Badge } from '@/components/ui/badge';
import { db } from '../../lib/db';
import type { Post } from '../../lib/db';

const { data: allPosts } = await db
  .from('posts')
  .select('id,slug,title,description,date,tags,project,newsletter,reading_time')
  .eq('draft', false)
  .order('date', { ascending: false });

const posts = (allPosts ?? []) as Pick<Post, 'id'|'slug'|'title'|'description'|'date'|'tags'|'project'|'newsletter'|'reading_time'>[];

const allTags = [...new Set(posts.flatMap((p) => p.tags ?? []))].sort();

const activeTag = Astro.url.searchParams.get('tag');
const filtered = activeTag
  ? posts.filter((p) => (p.tags ?? []).includes(activeTag))
  : posts;
---

<Base title="Blog — valb">
  <div class="mx-auto grid max-w-5xl grid-cols-1 gap-10 px-6 py-16 md:grid-cols-[180px_1fr]">

    <!-- Sidebar: tags -->
    <aside class="hidden md:block">
      <div class="sticky top-24 flex flex-col gap-1">
        <a href="/blog">
          <Badge variant={!activeTag ? 'default' : 'outline'} className="mb-1">all</Badge>
        </a>
        {allTags.map((tag) => (
          <a href={`/blog?tag=${tag}`}>
            <Badge variant={activeTag === tag ? 'default' : 'outline'} className="mb-1">{tag}</Badge>
          </a>
        ))}
      </div>
    </aside>

    <!-- Main content -->
    <main>
      <div class="mb-8">
        <h1 class="text-2xl font-semibold">Blog</h1>
        <p class="mt-1 text-sm text-muted-foreground">
          {filtered.length} post{filtered.length !== 1 ? 's' : ''}
          {activeTag && ` · filtrando "${activeTag}"`}
        </p>
      </div>

      <!-- Mobile tag row -->
      <div class="mb-6 flex flex-wrap gap-2 md:hidden">
        <a href="/blog"><Badge variant={!activeTag ? 'default' : 'outline'}>all</Badge></a>
        {allTags.map((tag) => (
          <a href={`/blog?tag=${tag}`}><Badge variant={activeTag === tag ? 'default' : 'outline'}>{tag}</Badge></a>
        ))}
      </div>

      {filtered.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {filtered.map((post, i) => (
            <PostCard
              id={post.id}
              slug={post.slug}
              title={post.title}
              description={post.description}
              date={post.date}
              tags={post.tags}
              project={post.project}
              newsletter={post.newsletter}
              reading_time={post.reading_time}
              delay={i * 40}
            />
          ))}
        </div>
      ) : (
        <p class="mt-8 text-sm text-muted-foreground">
          nenhum post encontrado{activeTag ? ` para "${activeTag}"` : ''}.
        </p>
      )}
    </main>
  </div>
</Base>
