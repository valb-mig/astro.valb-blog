---
import Base from '../../layouts/Base.astro';
import ActivityItem from '../../components/ActivityItem.astro';
import ActivityHeatmap from '../../components/ActivityHeatmap.astro';
import { Button } from '@/components/ui/button';
import { SelectField } from '@/components/SelectField';
import { app } from '@/app';

const admin = Astro.locals.admin;

const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const repo = Astro.url.searchParams.get('repo') ?? '';

const [days, feed, repos] = await Promise.all([
  app.posts.days(admin),
  app.events.feed(page, admin, repo),
  admin ? app.projects.repos() : [],
]);

const options = [
  { value: '__all__', label: 'todos os repos' },
  ...[...new Set(repos.flatMap((r) => (r.repo ? [r.repo] : [])))].map((r) => ({ value: r, label: r })),
];

function href(p: number): string {
  return `?page=${p}${repo ? `&repo=${encodeURIComponent(repo)}` : ''}`;
}

function format(day: string): string {
  return new Date(`${day}T00:00:00Z`).toLocaleDateString('pt-BR', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}
---

<Base title="Atividade — valb" breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Atividade' }]}>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <div class="mb-8 flex items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold">Atividade</h1>
        <p class="mt-1 text-sm text-muted-foreground">commits, issues, PRs e releases recentes.</p>
      </div>
      {admin && (
        <form method="GET" class="shrink-0">
          <input type="hidden" name="repo" id="repo-filter" value={repo} />
          <SelectField
            client:load
            hiddenInputId="repo-filter"
            initialValue={repo || '__all__'}
            options={options}
            className="w-48"
          />
        </form>
      )}
    </div>

    <ActivityHeatmap activeDays={days} class="mb-10" />

    {feed.days.length > 0 ? (
      <div class="flex flex-col gap-8">
        {feed.days.map((group) => (
          <section>
            <h2 class="mb-2 text-sm font-medium capitalize text-muted-foreground">
              {format(group.day)}
            </h2>
            <div class="flex flex-col">
              {group.events.map((event, i) => (
                <ActivityItem event={event} admin={admin} delay={i * 20} />
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <p class="mt-8 text-sm text-muted-foreground">nenhuma atividade encontrada.</p>
    )}

    {feed.pages > 1 && (
      <div class="mt-10 flex items-center justify-between border-t border-border pt-6">
        <Button variant="outline" size="sm" disabled={page <= 1} asChild={page > 1}>
          {page > 1 ? <a href={href(page - 1)}>← anterior</a> : <span>← anterior</span>}
        </Button>
        <span class="text-xs text-muted-foreground">página {page} de {feed.pages}</span>
        <Button variant="outline" size="sm" disabled={page >= feed.pages} asChild={page < feed.pages}>
          {page < feed.pages ? <a href={href(page + 1)}>próxima →</a> : <span>próxima →</span>}
        </Button>
      </div>
    )}
  </div>
</Base>

{admin && (
  <script>
    document.addEventListener('row-deleted', (e) => {
      const { id } = (e as CustomEvent).detail;
      document.querySelector(`[data-id="${id}"]`)?.remove();
    });

    document.getElementById('repo-filter')?.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.value === '__all__') el.value = '';
      el.form?.submit();
    });
  </script>
)}
