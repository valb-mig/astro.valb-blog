---
import { Button } from '@/components/ui/button';
import { Rss, Settings, Search } from 'lucide-react';

const navItems = [
  { label: 'Blog', href: '/blog' },
  { label: 'Projects', href: '/projects' },
  { label: 'About', href: '/about' },
];

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <a href="/" class="text-sm font-semibold">valb</a>

    <nav class="flex items-center gap-5 text-sm" aria-label="Navegação principal">
      {navItems.map(({ label, href }) => {
        const isActive = current === href || current.startsWith(href + '/');
        return (
          <a
            href={href}
            class={`transition-colors ${isActive ? 'text-foreground' : 'text-muted-foreground hover:text-foreground'}`}
          >
            {label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-1.5">
      <Button id="header-search-btn" variant="outline" size="sm">
        <Search />
        <span class="hidden sm:inline">Buscar</span>
        <kbd class="hidden rounded border border-border px-1 text-[10px] text-muted-foreground sm:inline">Ctrl K</kbd>
      </Button>

      <Button variant="ghost" size="icon" asChild>
        <a href="/rss.xml" title="RSS Feed" aria-label="RSS Feed">
          <Rss />
        </a>
      </Button>

      <Button variant="ghost" size="icon" asChild>
        <a href="/admin" title="Admin" aria-label="Admin" class="opacity-50 hover:opacity-100">
          <Settings />
        </a>
      </Button>
    </div>
  </div>
</header>

<script>
  document.getElementById('header-search-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('open-command-menu'));
  });
</script>
