---
import { Button } from '@/components/ui/button';
import { Rss, Settings, Search } from 'lucide-react';

const navItems = [
  { label: 'Posts', href: '/posts' },
  { label: 'Projects', href: '/projects' },
  { label: 'Atividade', href: '/atividade' },
  { label: 'About', href: '/about' },
];

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-md">
  <div class="mx-auto grid h-16 max-w-5xl grid-cols-[1fr_auto_1fr] items-center gap-2 px-4 sm:gap-4 sm:px-6">
    <div class="flex min-w-0 items-center gap-3 sm:gap-5">
      <a href="/" class="shrink-0 text-sm font-semibold">~/</a>
      <nav
        class="hidden items-center gap-5 text-sm md:flex"
        aria-label="Navegação principal"
      >
        {navItems.map(({ label, href }) => {
          const isActive = current === href || current.startsWith(href + '/');
          return (
            <a
              href={href}
              class={`shrink-0 transition-colors ${isActive ? 'text-foreground' : 'text-muted-foreground hover:text-foreground'}`}
            >
              {label}
            </a>
          );
        })}
      </nav>
    </div>

    <Button
      id="header-search-btn"
      variant="outline"
      size="sm"
      className="justify-start text-muted-foreground sm:w-56 md:w-72"
    >
      <Search />
      <span class="hidden flex-1 truncate text-left sm:inline">Buscar posts, projetos...</span>
      <kbd
        id="header-search-kbd"
        class="hidden rounded border border-border px-1 text-[10px] text-muted-foreground sm:inline"
      >
        Ctrl K
      </kbd>
    </Button>

    <div class="flex items-center justify-end gap-1.5">
      <Button variant="ghost" size="icon" asChild>
        <a href="/rss.xml" title="RSS Feed" aria-label="RSS Feed" class="text-muted-foreground hover:text-foreground">
          <Rss />
        </a>
      </Button>

      <Button variant="ghost" size="icon" asChild>
        <a href="/admin" title="Admin" aria-label="Admin" class="text-muted-foreground hover:text-foreground">
          <Settings />
        </a>
      </Button>
    </div>
  </div>
</header>

<script>
  document.getElementById('header-search-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('open-command-menu'));
  });

  const kbd = document.getElementById('header-search-kbd');
  if (kbd && /Mac|iPhone|iPad/.test(navigator.userAgent)) {
    kbd.textContent = '⌘K';
  }
</script>
