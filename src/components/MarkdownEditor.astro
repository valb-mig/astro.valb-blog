---
interface Props {
  initialValue?: string;
  name?: string;
  repos?: string[];
}
const { initialValue = '', name = 'content', repos = [] } = Astro.props;
---

<div class="md-editor-root" data-repos={JSON.stringify(repos)}>
  <div class="md-editor-tabs">
    <button type="button" class="md-tab active" data-tab="edit">edit</button>
    <button type="button" class="md-tab" data-tab="preview">preview</button>
  </div>

  <div class="md-editor-toolbar">
    {repos.length > 0 && (
      <button type="button" id="md-insert-event-btn" class="md-toolbar-btn">+ evento</button>
    )}
    <button type="button" id="md-insert-image-btn" class="md-toolbar-btn">+ imagem</button>
  </div>

  <dialog id="md-event-dialog">
    <div class="md-event-dialog-header">
      {repos.length > 1 && (
        <select id="md-event-repo">
          {repos.map((repo) => <option value={repo}>{repo}</option>)}
        </select>
      )}
      <input id="md-event-search" type="text" placeholder="buscar..." />
      <button type="button" id="md-event-dialog-close">fechar</button>
    </div>
    <div id="md-event-list"></div>
  </dialog>

  <div class="md-editor-panels">
    <div id="md-editor-panel" class="md-panel">
      <button type="button" class="md-maximize-btn" data-target="edit" title="maximizar">⛶</button>
      <div id="md-cm-mount"></div>
    </div>
    <div class="md-resizer"></div>
    <div id="md-preview-panel" class="md-panel prose prose-invert prose-sm md-preview">
      <button type="button" class="md-maximize-btn" data-target="preview" title="maximizar">⛶</button>
      <p style="color: var(--muted-foreground); font-size: 0.8125rem;">loading preview...</p>
    </div>
  </div>

  <!-- Hidden textarea synced with CodeMirror -->
  <textarea id="md-content-value" name={name} style="display:none">{initialValue}</textarea>
</div>

<style>
.md-editor-root {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.md-editor-tabs {
  display: none;
  align-items: center;
  gap: 0;
  border-bottom: 1px solid var(--border);
  background: var(--card);
  padding: 0 0.75rem;
}

.md-tab {
  font-family: inherit;
  font-size: 0.75rem;
  color: var(--muted-foreground);
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 0.6rem 0.75rem;
  cursor: pointer;
  transition: color 0.2s, border-color 0.2s;
}
.md-tab.active { color: var(--foreground); border-bottom-color: var(--foreground); }

.md-editor-toolbar {
  display: flex;
  gap: 0.5rem;
  border-bottom: 1px solid var(--border);
  background: var(--card);
  padding: 0.5rem 0.75rem;
}

.md-toolbar-btn {
  font-family: inherit;
  font-size: 0.75rem;
  color: var(--muted-foreground);
  background: none;
  border: 1px solid var(--border);
  border-radius: var(--radius-md, 4px);
  padding: 0.3rem 0.6rem;
  cursor: pointer;
  transition: color 0.2s, border-color 0.2s;
}
.md-toolbar-btn:hover { color: var(--foreground); border-color: var(--foreground); }

#md-event-dialog {
  width: min(480px, 90vw);
  max-height: 70vh;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--card);
  color: var(--foreground);
  padding: 0;
}
#md-event-dialog::backdrop { background: rgb(0 0 0 / 0.5); }

.md-event-dialog-header {
  display: flex;
  gap: 0.5rem;
  padding: 0.75rem;
  border-bottom: 1px solid var(--border);
}
.md-event-dialog-header select,
.md-event-dialog-header input {
  font-family: inherit;
  font-size: 0.8125rem;
  background: var(--background);
  border: 1px solid var(--border);
  border-radius: var(--radius-md, 4px);
  padding: 0.3rem 0.5rem;
  color: var(--foreground);
}
.md-event-dialog-header input { flex: 1; }

#md-event-list {
  overflow-y: auto;
  max-height: calc(70vh - 3rem);
}

.md-event-item {
  display: block;
  width: 100%;
  text-align: left;
  font-family: inherit;
  font-size: 0.8125rem;
  background: none;
  border: none;
  border-bottom: 1px solid var(--border);
  padding: 0.6rem 0.75rem;
  cursor: pointer;
  color: var(--foreground);
}
.md-event-item:hover { background: var(--accent); }
.md-event-item .md-event-type {
  font-size: 0.6875rem;
  color: var(--muted-foreground);
  text-transform: uppercase;
}

.md-editor-panels {
  display: grid;
  grid-template-columns: 1fr 6px 1fr;
  min-height: 480px;
}

.md-panel {
  overflow: auto;
  position: relative;
}

.md-resizer {
  cursor: col-resize;
  background: var(--border);
  position: relative;
}
.md-resizer::after {
  content: '';
  position: absolute;
  inset: 0 -4px;
}
.md-resizer:hover,
.md-resizer.dragging {
  background: var(--foreground);
}

.md-maximize-btn {
  position: absolute;
  top: 0.5rem;
  right: 0.5rem;
  z-index: 5;
  width: 1.5rem;
  height: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  line-height: 1;
  color: var(--muted-foreground);
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md, 4px);
  cursor: pointer;
  opacity: 0.6;
  transition: opacity 0.2s, color 0.2s;
}
.md-maximize-btn:hover {
  opacity: 1;
  color: var(--foreground);
}

.md-editor-panels.md-max-edit .md-resizer,
.md-editor-panels.md-max-edit #md-preview-panel,
.md-editor-panels.md-max-preview .md-resizer,
.md-editor-panels.md-max-preview #md-editor-panel {
  display: none;
}
.md-editor-panels.md-max-edit,
.md-editor-panels.md-max-preview {
  grid-template-columns: 1fr !important;
}

.md-preview {
  padding: 1.25rem 1.5rem;
  background: var(--background);
  max-width: 100%;
}

/* Override .prose max-width in preview */
.md-preview.prose {
  max-width: 100%;
}

/* CodeMirror overrides to match theme */
:global(.cm-editor) {
  height: 100%;
  min-height: 480px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.875rem;
}
:global(.cm-scroller) { overflow: auto; }

@media (max-width: 768px) {
  .md-editor-tabs { display: flex; }
  .md-editor-panels {
    grid-template-columns: 1fr;
  }
  .md-resizer,
  .md-maximize-btn { display: none; }

  /* Mobile: tabs control visibility */
  .md-editor-panels[data-tab="edit"] #md-preview-panel { display: none; }
  .md-editor-panels[data-tab="preview"] #md-editor-panel { display: none; }
}
</style>

<script>
  import { EditorView, basicSetup } from 'codemirror';
  import { markdown } from '@codemirror/lang-markdown';
  import { oneDark } from '@codemirror/theme-one-dark';
  import { marked } from 'marked';

  const textarea = document.getElementById('md-content-value') as HTMLTextAreaElement;
  const previewEl = document.getElementById('md-preview-panel')!;
  const panelsEl = document.querySelector('.md-editor-panels')!;

  function renderPreview(content: string) {
    previewEl.innerHTML = marked.parse(content) as string;
  }

  const view = new EditorView({
    doc: textarea.value,
    extensions: [
      basicSetup,
      markdown(),
      oneDark,
      EditorView.updateListener.of((update) => {
        if (update.docChanged) {
          const content = update.state.doc.toString();
          textarea.value = content;
          renderPreview(content);
        }
      }),
    ],
    parent: document.getElementById('md-cm-mount')!,
  });

  renderPreview(textarea.value);

  // Mobile tabs
  document.querySelectorAll<HTMLButtonElement>('.md-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.md-tab').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      if (window.innerWidth <= 768) {
        panelsEl.setAttribute('data-tab', btn.dataset.tab ?? 'edit');
      }
    });
  });

  const isDesktop = () => window.innerWidth > 768;

  function syncPanelsForViewport() {
    if (!isDesktop()) {
      panelsEl.classList.remove('md-max-edit', 'md-max-preview');
      (panelsEl as HTMLElement).style.gridTemplateColumns = '';
    }
  }
  syncPanelsForViewport();
  window.addEventListener('resize', syncPanelsForViewport);

  // Desktop: resizable panels
  const resizer = document.querySelector<HTMLElement>('.md-resizer');
  let lastColumns = '1fr 6px 1fr';

  if (resizer) {
    resizer.addEventListener('mousedown', (e) => {
      if (!isDesktop()) return;
      e.preventDefault();
      resizer.classList.add('dragging');
      const panelsRect = (panelsEl as HTMLElement).getBoundingClientRect();

      const onMouseMove = (moveEvent: MouseEvent) => {
        const offsetX = moveEvent.clientX - panelsRect.left;
        const percent = Math.min(80, Math.max(20, (offsetX / panelsRect.width) * 100));
        lastColumns = `${percent}% 6px ${100 - percent}%`;
        (panelsEl as HTMLElement).style.gridTemplateColumns = lastColumns;
      };

      const onMouseUp = () => {
        resizer.classList.remove('dragging');
        document.removeEventListener('mousemove', onMouseMove);
        document.removeEventListener('mouseup', onMouseUp);
      };

      document.addEventListener('mousemove', onMouseMove);
      document.addEventListener('mouseup', onMouseUp);
    });
  }

  // Desktop: maximize/restore panel
  document.querySelectorAll<HTMLButtonElement>('.md-maximize-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!isDesktop()) return;
      const target = btn.dataset.target;
      const maxClass = target === 'edit' ? 'md-max-edit' : 'md-max-preview';
      const isMaximized = panelsEl.classList.contains(maxClass);

      panelsEl.classList.remove('md-max-edit', 'md-max-preview');
      (panelsEl as HTMLElement).style.gridTemplateColumns = '';

      if (!isMaximized) {
        panelsEl.classList.add(maxClass);
        btn.textContent = '⛶';
      } else {
        (panelsEl as HTMLElement).style.gridTemplateColumns = lastColumns;
      }
    });
  });

  // Expose view for external access if needed
  (window as any).__mdEditor = view;

  function insertAtCursor(text: string) {
    const pos = view.state.selection.main.head;
    view.dispatch({ changes: { from: pos, insert: text } });
    view.focus();
  }

  // "+ imagem": prompt de URL/alt, sem upload (não há storage configurado)
  document.getElementById('md-insert-image-btn')?.addEventListener('click', () => {
    const imgUrl = prompt('URL da imagem:');
    if (!imgUrl) return;
    const alt = prompt('Texto alternativo (opcional):') ?? '';
    insertAtCursor(`![${alt}](${imgUrl})`);
  });

  // "+ evento": dialog lista source_events do(s) repo(s) vinculado(s) ao post
  const repos: string[] = JSON.parse(document.querySelector('.md-editor-root')?.getAttribute('data-repos') ?? '[]');
  const eventDialog = document.getElementById('md-event-dialog') as HTMLDialogElement | null;
  const eventList = document.getElementById('md-event-list');
  const eventSearch = document.getElementById('md-event-search') as HTMLInputElement | null;
  const eventRepoSelect = document.getElementById('md-event-repo') as HTMLSelectElement | null;

  type SourceEvent = { id: string; type: string; title: string; url: string; occurred_at: string };
  let loadedEvents: SourceEvent[] = [];

  function renderEventList(filter: string) {
    if (!eventList) return;
    const term = filter.trim().toLowerCase();
    const filtered = term ? loadedEvents.filter((e) => e.title.toLowerCase().includes(term)) : loadedEvents;

    eventList.innerHTML = filtered.length
      ? ''
      : '<p style="padding: 0.75rem; font-size: 0.8125rem; color: var(--muted-foreground);">nenhum evento encontrado.</p>';

    filtered.forEach((event) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'md-event-item';
      btn.innerHTML = `<span class="md-event-type">${event.type}</span><br>${event.title}`;
      btn.addEventListener('click', () => {
        insertAtCursor(`> 🔧 **${event.type}** — [${event.title}](${event.url})\n`);
        eventDialog?.close();
      });
      eventList.appendChild(btn);
    });
  }

  async function loadEventsForRepo(repo: string) {
    if (eventList) eventList.innerHTML = '<p style="padding: 0.75rem; font-size: 0.8125rem; color: var(--muted-foreground);">carregando...</p>';
    const res = await fetch(`/api/events?repo=${encodeURIComponent(repo)}`);
    loadedEvents = res.ok ? await res.json() : [];
    renderEventList(eventSearch?.value ?? '');
  }

  document.getElementById('md-insert-event-btn')?.addEventListener('click', () => {
    if (!repos.length) return;
    const repo = eventRepoSelect?.value ?? repos[0];
    loadEventsForRepo(repo);
    eventDialog?.showModal();
  });

  document.getElementById('md-event-dialog-close')?.addEventListener('click', () => eventDialog?.close());
  eventRepoSelect?.addEventListener('change', () => loadEventsForRepo(eventRepoSelect.value));
  eventSearch?.addEventListener('input', () => renderEventList(eventSearch.value));
</script>
