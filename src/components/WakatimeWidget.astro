---
import { getWakatimeStats } from '../lib/wakatime';

const stats = await getWakatimeStats();
---

{stats && (
  <div class="flex flex-col gap-3 rounded-lg border border-border p-4">
    <div class="flex items-center justify-between text-sm">
      <span class="text-muted-foreground">últimos 7 dias codificando</span>
      <span class="font-medium">{stats.totalText}</span>
    </div>
    <div class="flex flex-col gap-1.5">
      {stats.languages.map((lang) => (
        <div class="flex items-center gap-2 text-xs">
          <span class="w-20 shrink-0 truncate text-muted-foreground">{lang.name}</span>
          <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-border">
            <div class="h-full rounded-full bg-foreground" style={`width: ${lang.percent}%`} />
          </div>
          <span class="w-10 shrink-0 text-right text-muted-foreground">{lang.percent.toFixed(0)}%</span>
        </div>
      ))}
    </div>
  </div>
)}
