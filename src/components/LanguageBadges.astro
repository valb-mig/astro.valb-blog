---
import { Icon } from 'astro-icon/components';
import type { Languages } from '@/core/project/project';
import { languageIcon } from '../lib/icons';

interface Props {
  languages?: Languages | null;
  max?: number;
}

const { languages, max = 4 } = Astro.props;

const top = Object.entries(languages ?? {})
  .sort(([, a], [, b]) => b - a)
  .slice(0, max)
  .map(([name, percent]) => ({ name, percent, icon: languageIcon(name) }));
---

{top.length > 0 && (
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
    {top.map(({ name, percent, icon }) => (
      <span class="flex items-center gap-1.5 text-xs text-muted-foreground" title={`${name} ${percent.toFixed(1)}%`}>
        {icon ? (
          <Icon name={icon} class="size-3.5 shrink-0" aria-hidden="true" />
        ) : (
          <span class="size-2 shrink-0 rounded-full bg-muted-foreground/60" />
        )}
        {name}
        <span class="opacity-60">{percent.toFixed(0)}%</span>
      </span>
    ))}
  </div>
)}
