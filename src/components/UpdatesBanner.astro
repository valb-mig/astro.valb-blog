---
interface Props {
  update: { id: string; message: string; ref_url: string | null };
}
const { update } = Astro.props;
---

<div
  id="updates-banner"
  data-update-id={update.id}
  class="flex items-center justify-center gap-3 border-b border-border bg-foreground/5 px-4 py-2 text-sm"
>
  <span class="truncate">
    {update.ref_url ? (
      <a href={update.ref_url} class="underline-offset-2 hover:underline">{update.message}</a>
    ) : (
      update.message
    )}
  </span>
  <button
    id="updates-banner-close"
    aria-label="Fechar aviso"
    class="shrink-0 text-muted-foreground transition-colors hover:text-foreground"
  >
    ✕
  </button>
</div>

<script>
  const DISMISS_KEY = 'dismissed-update-id';
  const banner = document.getElementById('updates-banner');
  if (banner) {
    const id = banner.dataset.updateId;
    if (id && localStorage.getItem(DISMISS_KEY) === id) {
      banner.remove();
    } else {
      document.getElementById('updates-banner-close')?.addEventListener('click', () => {
        if (id) localStorage.setItem(DISMISS_KEY, id);
        banner.remove();
      });
    }
  }
</script>
