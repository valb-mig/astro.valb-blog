---
import { Card, CardContent } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';

interface Props {
  id: string;
  slug: string;
  title: string;
  description: string;
  date: string;
  tags?: string[];
  projects?: { slug: string; title: string }[];
  reading_time?: number;
  delay?: number;
}

const {
  slug,
  title,
  description,
  date,
  tags = [],
  projects = [],
  reading_time = 1,
  delay = 0,
} = Astro.props;

const dateStr = new Date(date).toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={`/blog/${slug}`} class="fade-in group block h-full" style={`transition-delay: ${delay}ms`}>
  <Card className="h-full transition-colors group-hover:ring-foreground/20">
    <CardContent className="flex h-full flex-col gap-3">
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground">
        <span class="whitespace-nowrap">{dateStr}</span>
        <div class="flex flex-wrap items-center gap-1.5">
          {projects.map((p) => <Badge variant="secondary">{p.title}</Badge>)}
        </div>
      </div>

      <h3 class="line-clamp-2 text-base font-semibold transition-colors group-hover:text-foreground/80">
        {title}
      </h3>

      <p class="line-clamp-2 flex-1 text-sm leading-relaxed text-muted-foreground">
        {description}
      </p>

      <div class="mt-auto flex flex-wrap items-center justify-between gap-2 border-t border-border pt-3">
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag) => <Badge variant="outline">{tag}</Badge>)}
        </div>
        <span class="whitespace-nowrap text-xs text-muted-foreground">{reading_time} min</span>
      </div>
    </CardContent>
  </Card>
</a>
