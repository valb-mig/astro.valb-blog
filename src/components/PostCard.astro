---
interface Props {
  id: string;
  slug: string;
  title: string;
  description: string;
  date: string;
  tags?: string[];
  project?: string | null;
  newsletter?: boolean;
  reading_time?: number;
  delay?: number;
}

const {
  slug,
  title,
  description,
  date,
  tags = [],
  project,
  newsletter = false,
  reading_time = 1,
  delay = 0,
} = Astro.props;

const dateStr = new Date(date).toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="post-card fade-in" style={`transition-delay: ${delay}ms`}>
  <a href={`/blog/${slug}`} class="card-link">

    <!-- File header row -->
    <div class="card-file-row">
      <!-- MD file icon -->
      <svg class="file-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14,2 14,8 20,8"/>
        <line x1="16" y1="13" x2="8" y2="13"/>
        <line x1="16" y1="17" x2="8" y2="17"/>
        <line x1="10" y1="9" x2="8" y2="9"/>
      </svg>
      <span class="card-filename">{slug}.md</span>
      <div class="card-badges">
        {newsletter && <span class="badge badge-accent">newsletter</span>}
        {project && <span class="badge badge-border">⬡ {project}</span>}
      </div>
      <span class="card-date">{dateStr}</span>
    </div>

    <!-- Title -->
    <h3 class="card-title">{title}</h3>

    <!-- Description -->
    <p class="card-desc">{description}</p>

    <!-- Footer -->
    <div class="card-footer">
      <div class="card-tags">
        {tags.map((tag) => (
          <span class="card-tag">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg>
            {tag}
          </span>
        ))}
      </div>
      <span class="card-reading">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
        {reading_time} min
      </span>
    </div>
  </a>
</article>

<style>
.post-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  overflow: hidden;
  transition: border-color 0.2s, box-shadow 0.2s;
  display: flex;
  flex-direction: column;
}
.post-card:hover {
  border-color: var(--accent);
  box-shadow: 0 0 0 1px rgba(52,211,153,0.1), 0 4px 16px rgba(0,0,0,0.3);
}

.card-link {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  padding: 1rem 1.25rem 1rem;
  text-decoration: none;
  height: 100%;
}

/* File header row */
.card-file-row {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  border-bottom: 1px solid var(--border);
  padding-bottom: 0.6rem;
  font-size: 0.7rem;
}
.file-icon {
  color: #519aba;  /* markdown blue, VSCode-like */
  flex-shrink: 0;
}
.card-filename {
  color: var(--subtle);
  font-size: 0.7rem;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-badges {
  display: flex;
  gap: 0.3rem;
  flex-shrink: 0;
}
.card-date {
  color: var(--subtle);
  font-size: 0.65rem;
  white-space: nowrap;
  flex-shrink: 0;
}

/* Badges */
.badge {
  font-size: 0.6rem;
  padding: 0.1em 0.45em;
  border-radius: 2px;
  white-space: nowrap;
}
.badge-accent { color: var(--accent); border: 1px solid rgba(52,211,153,0.4); }
.badge-border { color: var(--subtle); border: 1px solid var(--border); }

/* Title */
.card-title {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color 0.2s;
}
.post-card:hover .card-title { color: var(--accent); }

/* Description */
.card-desc {
  font-size: 0.8rem;
  color: var(--muted);
  line-height: 1.6;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Footer */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem;
  padding-top: 0.6rem;
  border-top: 1px solid var(--border);
  margin-top: auto;
}
.card-tags {
  display: flex;
  gap: 0.3rem;
  flex-wrap: wrap;
}
.card-tag {
  display: flex;
  align-items: center;
  gap: 0.2rem;
  font-size: 0.65rem;
  color: var(--subtle);
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 0.1em 0.4em;
  border-radius: 2px;
  transition: color 0.2s, border-color 0.2s;
}
.post-card:hover .card-tag {
  color: var(--muted);
  border-color: var(--subtle);
}
.card-reading {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.65rem;
  color: var(--subtle);
  white-space: nowrap;
}
</style>
