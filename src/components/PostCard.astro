---
import { Card, CardContent } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { DeleteButton } from '@/components/DeleteButton';
import { Pencil } from 'lucide-react';

interface Props {
  id: string;
  slug: string;
  title: string;
  description: string;
  date: string;
  tags?: string[];
  projects?: { slug: string; title: string }[];
  reading_time?: number;
  draft?: boolean;
  isAdmin?: boolean;
  delay?: number;
}

const {
  id,
  slug,
  title,
  description,
  date,
  tags = [],
  projects = [],
  reading_time = 1,
  draft = false,
  isAdmin = false,
  delay = 0,
} = Astro.props;

const dateStr = new Date(date).toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<div class="fade-in h-full" style={`transition-delay: ${delay}ms`}>
  <Card className="h-full transition-colors hover:ring-foreground/20">
    <CardContent className="flex h-full flex-col gap-3">
      <div class="flex items-center justify-between gap-2 text-xs text-muted-foreground">
        <span class="whitespace-nowrap">{dateStr}</span>
        {isAdmin && (
          <div class="flex shrink-0 items-center gap-0.5">
            <a
              href={`/admin/posts/${id}`}
              title="editar"
              class="flex size-6 items-center justify-center rounded-md text-muted-foreground hover:text-foreground"
            >
              <Pencil size={12} />
            </a>
            <DeleteButton id={id} title={title} resource="posts" label="" client:load />
          </div>
        )}
      </div>

      {(draft || projects.length > 0) && (
        <div class="flex flex-wrap items-center gap-1.5">
          {draft && <Badge variant="outline">draft</Badge>}
          {projects.map((p) => <Badge variant="secondary">{p.title}</Badge>)}
        </div>
      )}

      <a href={`/posts/${slug}`}>
        <h3 class="line-clamp-2 text-base font-semibold transition-colors hover:text-foreground/80">
          {title}
        </h3>
      </a>

      <p class="line-clamp-2 flex-1 text-sm leading-relaxed text-muted-foreground">
        {description}
      </p>

      <div class="mt-auto flex flex-wrap items-center justify-between gap-2 border-t border-border pt-3">
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag) => <Badge variant="outline">{tag}</Badge>)}
        </div>
        <span class="whitespace-nowrap text-xs text-muted-foreground">{reading_time} min</span>
      </div>
    </CardContent>
  </Card>
</div>
