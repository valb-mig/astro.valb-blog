---
import { Card, CardContent } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { DeleteButton } from '@/components/DeleteButton';
import { PinButton } from '@/components/PinButton';
import { FileText, GitCommitHorizontal, Pencil, Pin } from 'lucide-react';
import { Icon } from 'astro-icon/components';
import { cover, type Status, type Summary } from '@/core/project/project';
import { app } from '@/app';
import LanguageBadges from './LanguageBadges.astro';
import OrgBadge from './OrgBadge.astro';
import { ago } from '../lib/time';

interface Props {
  project: Summary;
  pinned?: boolean;
  last?: string | null;
  admin?: boolean;
  delay?: number;
}

const { project, pinned = false, last = null, admin = false, delay = 0 } = Astro.props;
const { id, title, description, slug, tags, status, repo, languages, posts, draft } = project;

const repoUrl = repo ? `https://github.com/${repo}` : undefined;
const org = app.projects.org(repo);
const image = cover(project);
const count = posts === 0 ? 'sem posts' : posts === 1 ? '1 post' : `${posts} posts`;
const recent = last != null && Date.now() - Date.parse(last) < 7 * 86_400_000;

const variant: { [s in Status]: 'default' | 'secondary' | 'outline' } = {
  active: 'default',
  completed: 'secondary',
  archived: 'outline',
};
---

<Card className="fade-in h-full" style={{ transitionDelay: `${delay}ms` }}>
  {image && (
    <a href={`/projects/${slug}`} tabindex="-1" aria-hidden="true" class="block overflow-hidden">
      <img
        src={image}
        alt=""
        loading="lazy"
        onerror="this.closest('a').remove()"
        class="aspect-[2/1] w-full object-cover transition-transform duration-300 hover:scale-[1.02]"
      />
    </a>
  )}
  <CardContent className="flex h-full flex-col gap-3">
    <div class="flex items-center justify-between gap-2">
      <a href={`/projects/${slug}`} class="group min-w-0 truncate">
        <span class="text-base font-semibold transition-colors group-hover:text-foreground/80">{title}</span>
      </a>
      <div class="flex shrink-0 items-center gap-1.5">
        {pinned && !admin && <Pin size={13} className="text-amber-400" aria-label="fixado" />}
        {draft && <Badge variant="outline">draft</Badge>}
        <Badge variant={variant[status]}>{status}</Badge>
        {admin && (
          <div class="flex items-center gap-0.5">
            <PinButton id={id} pinned={pinned} client:load />
            <a
              href={`/admin/projects/${id}`}
              title="editar"
              class="flex size-6 items-center justify-center rounded-md text-muted-foreground hover:text-foreground"
            >
              <Pencil size={12} />
            </a>
            <DeleteButton id={id} title={title} resource="projects" label="" client:load />
          </div>
        )}
      </div>
    </div>

    {org && (
      <div class="-mt-1 flex">
        <OrgBadge org={org} />
      </div>
    )}

    <p class="line-clamp-2 flex-1 text-sm leading-relaxed text-muted-foreground">{description}</p>

    <LanguageBadges languages={languages} />

    <div class="mt-auto flex flex-col gap-3 border-t border-border pt-3">
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag) => <Badge variant="outline">{tag}</Badge>)}
        </div>
      )}
      <div class="flex items-center gap-4 text-xs text-muted-foreground">
        <a
          href={`/projects/${slug}#posts`}
          class={`flex items-center gap-1.5 transition-colors hover:text-foreground ${posts > 0 ? 'text-foreground/80' : ''}`}
        >
          <FileText size={13} />
          {count}
        </a>
        {last && (
          <span
            class={`flex items-center gap-1.5 ${recent ? 'text-emerald-400' : ''}`}
            title={`último commit em ${new Date(last).toLocaleDateString('pt-BR')}`}
          >
            <GitCommitHorizontal size={13} />
            {ago(last)}
          </span>
        )}
        {repoUrl && (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener"
            class="ml-auto flex items-center gap-1.5 transition-colors hover:text-foreground"
          >
            <Icon name="simple-icons:github" class="size-3.5" aria-hidden="true" />
            repo
          </a>
        )}
      </div>
    </div>
  </CardContent>
</Card>
