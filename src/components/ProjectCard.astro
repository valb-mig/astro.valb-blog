---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  status?: 'active' | 'completed' | 'archived';
  repo?: string;
  url?: string;
  postCount?: number;
  delay?: number;
}

const {
  title,
  description,
  slug,
  tags = [],
  status = 'active',
  repo,
  url,
  postCount = 0,
  delay = 0,
} = Astro.props;

const statusDot: Record<string, string> = {
  active: '#34d399',
  completed: '#a1a1aa',
  archived: '#52525b',
};
const statusLabel: Record<string, string> = {
  active: 'active',
  completed: 'completed',
  archived: 'archived',
};
---

<article class="project-card fade-in" style={`transition-delay: ${delay}ms`}>
  <!-- Top row: folder icon + title + status -->
  <div class="proj-header">
    <a href={`/projects/${slug}`} class="proj-title-link">
      <svg class="folder-icon" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" stroke="none">
        <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/>
      </svg>
      <span class="proj-title">{title}</span>
    </a>
    <span class="status-badge" style={`border-color: ${statusDot[status]}40`}>
      <span class="status-dot" style={`background: ${statusDot[status]}`}></span>
      {statusLabel[status]}
    </span>
  </div>

  <!-- Description -->
  <p class="proj-desc">{description}</p>

  <!-- Footer -->
  <div class="proj-footer">
    <div class="proj-tags">
      {tags.map((tag) => (
        <span class="proj-tag">
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg>
          {tag}
        </span>
      ))}
    </div>
    <div class="proj-links">
      {postCount > 0 && (
        <a href={`/projects/${slug}#posts`} class="proj-link">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/></svg>
          {postCount}
        </a>
      )}
      {repo && (
        <a href={repo} target="_blank" rel="noopener" class="proj-link">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          repo
        </a>
      )}
      {url && (
        <a href={url} target="_blank" rel="noopener" class="proj-link">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15,3 21,3 21,9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          site
        </a>
      )}
    </div>
  </div>
</article>

<style>
.project-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 1rem 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.project-card:hover {
  border-color: var(--accent);
  box-shadow: 0 0 0 1px rgba(52,211,153,0.1), 0 4px 16px rgba(0,0,0,0.3);
}

.proj-header {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  justify-content: space-between;
}
.proj-title-link {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  text-decoration: none;
  min-width: 0;
}
.folder-icon { color: #e5c07b; flex-shrink: 0; }
.proj-title {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--text);
  transition: color 0.2s;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.proj-title-link:hover .proj-title { color: var(--accent); }

.status-badge {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.65rem;
  color: var(--subtle);
  border: 1px solid;
  border-radius: 20px;
  padding: 0.15em 0.6em;
  white-space: nowrap;
  flex-shrink: 0;
}
.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}

.proj-desc {
  font-size: 0.8rem;
  color: var(--muted);
  line-height: 1.6;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.proj-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem;
  padding-top: 0.6rem;
  border-top: 1px solid var(--border);
  margin-top: auto;
}
.proj-tags {
  display: flex;
  gap: 0.3rem;
  flex-wrap: wrap;
}
.proj-tag {
  display: flex;
  align-items: center;
  gap: 0.2rem;
  font-size: 0.65rem;
  color: var(--subtle);
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 0.1em 0.4em;
  border-radius: 2px;
}
.proj-links {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}
.proj-link {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.65rem;
  color: var(--subtle);
  text-decoration: none;
  transition: color 0.2s;
}
.proj-link:hover { color: var(--accent); }
</style>
