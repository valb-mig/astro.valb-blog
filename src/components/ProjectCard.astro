---
import { Card, CardContent } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';

interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  status?: 'active' | 'completed' | 'archived';
  repo?: string;
  url?: string;
  postCount?: number;
  delay?: number;
}

const {
  title,
  description,
  slug,
  tags = [],
  status = 'active',
  repo,
  url,
  postCount = 0,
  delay = 0,
} = Astro.props;

const statusVariant: Record<string, 'default' | 'secondary' | 'outline'> = {
  active: 'default',
  completed: 'secondary',
  archived: 'outline',
};
---

<Card className="fade-in h-full" style={`transition-delay: ${delay}ms`}>
  <CardContent className="flex h-full flex-col gap-3">
    <div class="flex items-center justify-between gap-2">
      <a href={`/projects/${slug}`} class="group min-w-0">
        <span class="truncate text-base font-semibold transition-colors group-hover:text-foreground/80">
          {title}
        </span>
      </a>
      <Badge variant={statusVariant[status]}>{status}</Badge>
    </div>

    <p class="line-clamp-2 flex-1 text-sm leading-relaxed text-muted-foreground">{description}</p>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-2 border-t border-border pt-3">
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => <Badge variant="outline">{tag}</Badge>)}
      </div>
      <div class="flex items-center gap-3 text-xs text-muted-foreground">
        {postCount > 0 && (
          <a href={`/projects/${slug}#posts`} class="transition-colors hover:text-foreground">
            {postCount} posts
          </a>
        )}
        {repo && (
          <a href={repo} target="_blank" rel="noopener" class="transition-colors hover:text-foreground">
            repo
          </a>
        )}
        {url && (
          <a href={url} target="_blank" rel="noopener" class="transition-colors hover:text-foreground">
            site
          </a>
        )}
      </div>
    </div>
  </CardContent>
</Card>
