    <p>
      © {year} —
      <a href="https://github.com/valb-mig" target="_blank" rel="noopener" class="transition-colors hover:text-foreground">
        valb-mig
      </a>
    </p>

    <div class="flex items-center gap-4">
      <a href="/rss.xml" class="flex items-center gap-1.5 transition-colors hover:text-foreground">
