---
import { LayoutDashboard, FileText, FolderGit2, Calendar, Settings } from 'lucide-react';

const navItems = [
  { label: 'Dashboard', href: '/admin', icon: LayoutDashboard, exact: true },
  { label: 'Posts', href: '/admin/posts', icon: FileText },
  { label: 'Projects', href: '/admin/projects', icon: FolderGit2 },
  { label: 'Events', href: '/admin/events', icon: Calendar },
  { label: 'Settings', href: '/admin/settings', icon: Settings },
];

const current = Astro.url.pathname;
---

<nav
  class="fixed inset-x-0 bottom-0 z-50 grid h-16 grid-cols-5 border-t border-border bg-background/95 backdrop-blur-md md:hidden"
  aria-label="Navegação admin (mobile)"
>
  {navItems.map(({ label, href, icon: Icon, exact }) => {
    const isActive = exact ? current === href : current.startsWith(href);
    return (
      <a
        href={href}
        class={`flex flex-col items-center justify-center gap-0.5 text-[11px] transition-colors ${isActive ? 'text-foreground' : 'text-muted-foreground'}`}
      >
        <Icon size={20} />
        {label}
      </a>
    );
  })}
</nav>
