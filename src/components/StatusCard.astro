---
import { Card, CardContent } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { ExternalLink, Tag as TagIcon, Terminal } from 'lucide-react';
import type { Card as Status } from '@/core/project/project';
import { link, up, vital, type Level } from '@/core/project/vital';
import { app } from '@/app';
import LanguageBadges from './LanguageBadges.astro';
import OrgBadge from './OrgBadge.astro';
import { faviconUrl } from '../lib/icons';

interface Props {
  card: Status;
  last?: string | null;
  admin?: boolean;
  delay?: number;
}

const { card, last, admin = false, delay = 0 } = Astro.props;
const { title, slug, repo, languages, draft, uptimeUrl } = card;
const { ci, release, releaseAt, code, codeAt, deploy, deployAt } = card.health;

const variant: { [ci: string]: 'default' | 'secondary' | 'destructive' | 'outline' } = {
  success: 'default',
  failure: 'destructive',
  timed_out: 'destructive',
  cancelled: 'secondary',
  in_progress: 'secondary',
  queued: 'secondary',
};

const dot: { [l in Level]: string } = {
  ok: 'bg-emerald-500',
  warn: 'bg-amber-500',
  down: 'bg-red-500',
  unknown: 'bg-muted-foreground/40',
};

const site = link(card);
const org = app.projects.org(repo);
const web = site != null;
const health = vital(card);
const online = up(code);
const releaseUrl = repo && release ? `https://github.com/${repo}/releases/tag/${release}` : null;
const version = deploy?.version as string | undefined;

const short = (iso: string) => new Date(iso).toLocaleDateString('pt-BR', { day: 'numeric', month: 'short' });
---

<Card
  className={`fade-in h-full ${
    web
      ? 'border-emerald-500/25 bg-gradient-to-b from-emerald-500/[0.04] to-transparent'
      : 'border-dashed border-border/70 bg-muted/10 font-mono'
  }`}
  style={{ transitionDelay: `${delay}ms` }}
>
  <CardContent className="flex h-full flex-col gap-3">
    <div class="flex items-center justify-between gap-2">
      <a href={`/projects/${slug}`} class="group flex min-w-0 items-center gap-2">
        <span class="relative flex size-2.5 shrink-0" title={health.label}>
          {health.level === 'ok' && (
            <span class={`absolute inline-flex size-full animate-ping rounded-full opacity-75 ${dot[health.level]}`} />
          )}
          <span class={`relative inline-flex size-2.5 rounded-full ${dot[health.level]}`} />
        </span>
        {web ? (
          <img src={faviconUrl(site as string)} alt="" width={16} height={16} loading="lazy" class="size-4 shrink-0 rounded-sm" />
        ) : (
          <Terminal size={14} className="shrink-0 text-muted-foreground" />
        )}
        <span class={`truncate font-semibold transition-colors group-hover:text-foreground/80 ${web ? 'text-base' : 'text-sm'}`}>
          {title}
        </span>
      </a>
      <div class="flex shrink-0 items-center gap-1.5">
        {draft && <Badge variant="outline">draft</Badge>}
        {site && (
          <a
            href={site}
            target="_blank"
            rel="noopener"
            title="abrir projeto"
            class="flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground"
          >
            <ExternalLink size={12} />
            site
          </a>
        )}
      </div>
    </div>

    <LanguageBadges languages={languages} />

    <div class="flex flex-wrap items-center gap-2">
      {org && <OrgBadge org={org} />}
      {ci && <Badge variant={variant[ci] ?? 'secondary'}>ci: {ci}</Badge>}
      {uptimeUrl && (
        <Badge variant={code == null ? 'outline' : online ? 'default' : 'destructive'}>
          {code == null ? 'uptime: sem resposta' : online ? 'uptime: ok' : `uptime: ${code}`}
        </Badge>
      )}
      {releaseUrl ? (
        <a href={releaseUrl} target="_blank" rel="noopener">
          <Badge variant="outline" className="flex items-center gap-1">
            <TagIcon size={11} />
            {release}
            {releaseAt && <span class="opacity-60">· {short(releaseAt)}</span>}
          </Badge>
        </a>
      ) : (
        version && <Badge variant="outline">{version}</Badge>
      )}
    </div>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-2 border-t border-border pt-3 text-xs text-muted-foreground">
      <div class="flex items-center gap-3">
        {last && (
          <a href={`/atividade?repo=${encodeURIComponent(repo ?? '')}`} class="transition-colors hover:text-foreground">
            último commit {short(last)}
          </a>
        )}
        {codeAt && <span>check {short(codeAt)}</span>}
      </div>
      {repo && (
        <a href={`https://github.com/${repo}`} target="_blank" rel="noopener" class="transition-colors hover:text-foreground">
          repo
        </a>
      )}
    </div>

    {admin && (deploy || deployAt) && (
      <details class="mt-1 text-xs text-muted-foreground">
        <summary class="cursor-pointer transition-colors hover:text-foreground">
          deploy_status {deployAt && `— ${short(deployAt)}`}
        </summary>
        <pre class="mt-2 overflow-x-auto rounded-md bg-muted p-2">{JSON.stringify(deploy, null, 2)}</pre>
      </details>
    )}
  </CardContent>
</Card>
