---
import { Card, CardContent } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { ExternalLink, Tag as TagIcon } from 'lucide-react';
import LanguageBadges from './LanguageBadges.astro';

interface Props {
  title: string;
  slug: string;
  repo?: string | null;
  languages?: Record<string, number> | null;
  draft?: boolean;
  ciStatus?: string | null;
  latestRelease?: string | null;
  latestReleaseAt?: string | null;
  uptimeUrl?: string | null;
  lastStatusCode?: number | null;
  lastUptimeCheckAt?: string | null;
  deployStatus?: Record<string, unknown> | null;
  deployStatusAt?: string | null;
  lastCommitAt?: string | null;
  isAdmin?: boolean;
  delay?: number;
}

const {
  title,
  slug,
  repo,
  languages,
  draft = false,
  ciStatus,
  latestRelease,
  latestReleaseAt,
  uptimeUrl,
  lastStatusCode,
  lastUptimeCheckAt,
  deployStatus,
  deployStatusAt,
  lastCommitAt,
  isAdmin = false,
  delay = 0,
} = Astro.props;

const CI_VARIANT: Record<string, 'default' | 'secondary' | 'destructive' | 'outline'> = {
  success: 'default',
  failure: 'destructive',
  timed_out: 'destructive',
  cancelled: 'secondary',
  in_progress: 'secondary',
  queued: 'secondary',
};

// deploy_status.url tem prioridade (link real reportado pelo deploy) — uptime_url
// é fallback, mesmo sendo um endpoint de health-check e não a home do projeto.
const webLink = (deployStatus?.url as string | undefined) ?? uptimeUrl ?? null;
const releaseUrl = repo && latestRelease ? `https://github.com/${repo}/releases/tag/${latestRelease}` : null;
const deployVersion = deployStatus?.version as string | undefined;
const uptimeUp = lastStatusCode != null && lastStatusCode >= 200 && lastStatusCode < 300;

// Vitals: um sinal só resumindo a saúde do projeto pra escaneio visual rápido.
// Prioridade: uptime (é o sinal mais direto de "tá no ar") > CI > só recebeu
// deploy_status (sem uptime/CI configurado, mas reportando vida) > sem dado.
type HealthLevel = 'ok' | 'warn' | 'down' | 'unknown';

function computeHealth(): { level: HealthLevel; label: string } {
  if (uptimeUrl) {
    if (lastStatusCode == null) return { level: 'unknown', label: 'uptime: sem resposta' };
    return uptimeUp ? { level: 'ok', label: 'online' } : { level: 'down', label: `offline (${lastStatusCode})` };
  }
  if (ciStatus) {
    if (ciStatus === 'success') return { level: 'ok', label: 'build ok' };
    if (ciStatus === 'failure' || ciStatus === 'timed_out') return { level: 'down', label: 'build falhou' };
    return { level: 'warn', label: `ci: ${ciStatus}` };
  }
  if (deployStatus) return { level: 'ok', label: 'reportando deploy' };
  return { level: 'unknown', label: 'sem dado de status' };
}

const health = computeHealth();
const HEALTH_DOT: Record<HealthLevel, string> = {
  ok: 'bg-emerald-500',
  warn: 'bg-amber-500',
  down: 'bg-red-500',
  unknown: 'bg-muted-foreground/40',
};

function relativeDate(iso: string): string {
  return new Date(iso).toLocaleDateString('pt-BR', { day: 'numeric', month: 'short' });
}
---

<Card className="fade-in h-full" style={{ transitionDelay: `${delay}ms` }}>
  <CardContent className="flex h-full flex-col gap-3">
    <div class="flex items-center justify-between gap-2">
      <a href={`/projects/${slug}`} class="group flex min-w-0 items-center gap-2">
        <span class="relative flex size-2.5 shrink-0" title={health.label}>
          {health.level === 'ok' && (
            <span class={`absolute inline-flex size-full animate-ping rounded-full opacity-75 ${HEALTH_DOT[health.level]}`} />
          )}
          <span class={`relative inline-flex size-2.5 rounded-full ${HEALTH_DOT[health.level]}`} />
        </span>
        <span class="truncate text-base font-semibold transition-colors group-hover:text-foreground/80">
          {title}
        </span>
      </a>
      <div class="flex shrink-0 items-center gap-1.5">
        {draft && <Badge variant="outline">draft</Badge>}
        {webLink && (
          <a
            href={webLink}
            target="_blank"
            rel="noopener"
            title="abrir projeto"
            class="flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground"
          >
            <ExternalLink size={12} />
            site
          </a>
        )}
      </div>
    </div>

    <LanguageBadges languages={languages} />

    <div class="flex flex-wrap items-center gap-2">
      {ciStatus && <Badge variant={CI_VARIANT[ciStatus] ?? 'secondary'}>ci: {ciStatus}</Badge>}
      {uptimeUrl && (
        <Badge variant={lastStatusCode == null ? 'outline' : uptimeUp ? 'default' : 'destructive'}>
          {lastStatusCode == null ? 'uptime: sem resposta' : uptimeUp ? 'uptime: ok' : `uptime: ${lastStatusCode}`}
        </Badge>
      )}
      {releaseUrl ? (
        <a href={releaseUrl} target="_blank" rel="noopener">
          <Badge variant="outline" className="flex items-center gap-1">
            <TagIcon size={11} />
            {latestRelease}
            {latestReleaseAt && <span class="opacity-60">· {relativeDate(latestReleaseAt)}</span>}
          </Badge>
        </a>
      ) : (
        deployVersion && <Badge variant="outline">{deployVersion}</Badge>
      )}
    </div>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-2 border-t border-border pt-3 text-xs text-muted-foreground">
      <div class="flex items-center gap-3">
        {lastCommitAt && (
          <a href={`/atividade?repo=${encodeURIComponent(repo ?? '')}`} class="transition-colors hover:text-foreground">
            último commit {relativeDate(lastCommitAt)}
          </a>
        )}
        {lastUptimeCheckAt && <span>check {relativeDate(lastUptimeCheckAt)}</span>}
      </div>
      {repo && (
        <a href={`https://github.com/${repo}`} target="_blank" rel="noopener" class="transition-colors hover:text-foreground">
          repo
        </a>
      )}
    </div>

    {isAdmin && (deployStatus || deployStatusAt) && (
      <details class="mt-1 text-xs text-muted-foreground">
        <summary class="cursor-pointer transition-colors hover:text-foreground">
          deploy_status {deployStatusAt && `— ${relativeDate(deployStatusAt)}`}
        </summary>
        <pre class="mt-2 overflow-x-auto rounded-md bg-muted p-2">{JSON.stringify(deployStatus, null, 2)}</pre>
      </details>
    )}
  </CardContent>
</Card>
