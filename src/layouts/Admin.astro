---
import '../styles/global.css';
import { Button } from '@/components/ui/button';
import { Toaster } from '@/components/ui/sonner';
import { LogOut } from 'lucide-react';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Admin</title>
  </head>
  <body>
    <Toaster client:load />
    <header class="sticky top-0 z-50 h-14 border-b border-border bg-background/95 backdrop-blur-md">
      <div class="mx-auto flex h-full max-w-5xl items-center justify-between px-6">
        <div class="flex items-center gap-8">
          <a href="/admin" class="text-sm font-semibold">Admin</a>
          <nav class="flex gap-6 text-sm">
            <a
              href="/admin"
              class={path === '/admin' ? 'text-foreground' : 'text-muted-foreground transition-colors hover:text-foreground'}
            >
              Dashboard
            </a>
            <a
              href="/admin/posts"
              class={path.startsWith('/admin/posts') ? 'text-foreground' : 'text-muted-foreground transition-colors hover:text-foreground'}
            >
              Posts
            </a>
            <a
              href="/admin/projects"
              class={path.startsWith('/admin/projects') ? 'text-foreground' : 'text-muted-foreground transition-colors hover:text-foreground'}
            >
              Projects
            </a>
            <a
              href="/admin/events"
              class={path.startsWith('/admin/events') ? 'text-foreground' : 'text-muted-foreground transition-colors hover:text-foreground'}
            >
              Events
            </a>
            <a
              href="/admin/settings"
              class={path.startsWith('/admin/settings') ? 'text-foreground' : 'text-muted-foreground transition-colors hover:text-foreground'}
            >
              Settings
            </a>
            <a href="/" target="_blank" class="text-muted-foreground transition-colors hover:text-foreground">
              ver site ↗
            </a>
          </nav>
        </div>
        <form method="POST" action="/api/auth/logout" id="logout-form">
          <Button type="submit" variant="ghost" size="sm">
            <LogOut />
            logout
          </Button>
        </form>
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-6 py-10 pb-32">
      <slot />
    </main>

    <script>
      import { consumeFlashedToast } from '../lib/toast';
      consumeFlashedToast();

      document.getElementById('logout-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      });
    </script>
  </body>
</html>
