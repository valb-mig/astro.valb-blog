SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_isso

# gere com: openssl rand -hex 32
SESSION_SECRET=change_me_32_random_bytes_hex

# scripts/ingest.ts — pipeline de ingest de atividade do GitHub (também via secrets no GitHub Actions)
GH_TOKEN=ghp_xxx
GH_USERNAME=seu-usuario-github

# admin/index.astro — botão "rodar ingest agora" dispara o workflow via API do GitHub
# (Settings > Developer settings > Fine-grained tokens, escopo restrito a este repo,
# permissão "Actions: Read and write")
GH_DISPATCH_TOKEN=github_pat_xxx
GH_REPO=seu-usuario-github/astro.valb-blog

# provider de normalização, trocável em runtime via /admin/settings (tabela `settings`, chave llm_provider);
# só precisa da key do provider ativo no momento, mas ambas podem ficar setadas
GROQ_API_KEY=gsk_xxx
GEMINI_API_KEY=AIza_xxx
